  },
  "LoadImage.1": {
    "class_type": "LoadImage",
    "inputs": {"image": "example.png"}
  },
  "MiniMaxH3SigmaShift.0": {
    "class_type": "MiniMaxH3SigmaShift",
    "inputs": {"model": ["UNETLoader.0", 0], "shift_video": 12.0, "shift_audio": 3.0}
  },
  "KSampler.0": {
    "class_type": "KSampler",
    "inputs": {
      "model": ["MiniMaxH3SigmaShift.0", 0],
      "positive": ["MiniMaxH3ImageToVideo.0", 0],
      "negative": ["MiniMaxH3ImageToVideo.0", 0],
      "seed": 42,
      "steps": 12,
      "cfg": 4.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "latent_image": ["MiniMaxH3ImageToVideo.0", 1],
      "denoise": 1.0
