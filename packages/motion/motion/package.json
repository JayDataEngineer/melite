{
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./card": {
      "types": "./lib/card.d.ts",
      "default": "./lib/card.js"
    },
    "./package.json": "./package.json",
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@melite-plugin/motion": "workspace:*",
    "@melite-plugin/timeline": "workspace:*",
    "@melite/card-base": "workspace:*",
    "@melite/catalog": "workspace:*",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/comfyui-cordis": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/estate-call": "workspace:*",
    "@melite/formats": "workspace:*",
    "@melite/models-kimodo": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@melite/three-client": "workspace:*"
  },
  "devDependencies": {
    "@testing-library/dom": "*",
    "@types/node": "^22.20.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@types/three": "^0.184.1",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "name": "@melite/motion-motion",
  "description": "the motion card (the motion lane) — one card one package: card.ts host face + ui/ studio + agents/ context",
  "dsh": {
    "client": {
      "platform": "web",
      "external": [
        "@melite/card-base/client",
        "@melite/three-client/client"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "sideEffects": true,
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.module.css",
    "cordis.patch.yml"
  ]
}
