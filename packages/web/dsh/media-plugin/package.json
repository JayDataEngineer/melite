{
  "name": "@infer-media/dsh-media",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown -c tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test:runs": "node test/runs-window.mjs",
    "test:door": "node --test test/host-door.test.mjs",
    "test:client": "vitest run",
    "test:e2e": "node test/e2e/build-harness.mjs && node test/e2e/e2e.mjs",
    "test": "node --test test/host-door.test.mjs && node --test test/artifact-range.test.mjs && vitest run && node test/e2e/build-harness.mjs && node test/e2e/e2e.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.7",
    "@testing-library/jest-dom": "^6.10.0",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.5",
    "jsdom": "^29.1.1",
    "lightningcss": "^1.30.0",
    "react": "~18.3.1",
    "react-dom": "~18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "~5.7.2",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "react": "^18.2.0"
  }
}