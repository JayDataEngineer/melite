# LOCAL OVERLAY TEMPLATE — copy to the same name without .example and replace
# $MELITE_REPO with this repo's absolute path. The dsh loader resolves HOST-row
# entry paths against the profile dir, so real paths MUST be absolute — which
# is exactly why the real file is gitignored (privacy hook: /home/<user>).

# W3 @melite-plugin/dsh-card-view isolated-boot overlay (port 3083; never the
# live :3080). TWO rows pointing at ONE package:
#
# - host row  — `name:` = ABSOLUTE path of the built node half. The loader
#               resolves relative entry paths against the PROFILE dir, not this
#               file (W0 failure #1), so the path must be absolute. This fiber
#               registers the /melite-proxy gateway pass-through route.
# - client row — `name:` = the package name itself. dsh-client-modules resolves
#               '<name>/package.json' from the profile tree, reads the
#               dsh.client declaration, and serves exports['./client'] at
#               /plugins/@melite-plugin/dsh-card-view/client.js + lists it in
#               __DSH_BOOT__. Its fiber sets clientRowOnly: true because both
#               rows import the same module and a second route registration
#               would throw ('webserver: duplicate prefix route').
#
# NOTE: the node half emits lib/index.js (ESM + "type": "module" -> .js under
# the shared tsdown preset; same as infer-gallery), NOT lib/index.mjs.
#
# One-time profile link (makes the package-name row resolvable):
#   DSH_HOME=/tmp/melite-dsh-home dsh plugin --profile web add link:$MELITE_REPO/dsh/melite-card-view
#
# Boot:
#   DSH_HOME=/tmp/melite-dsh-home dsh --profile web \
#     --patch $MELITE_REPO/dsh/melite-card-view/test-overlay.yml --port 3083

- id: webserver
  config:
    host: 127.0.0.1
    port: 3083

- insert:
    - id: melite-card-view-host
      name: $MELITE_REPO/dsh/melite-card-view/lib/index.js
      config:
        gatewayUrl: 'http://localhost:33081'
    - id: melite-card-view-client
      name: '@melite-plugin/dsh-card-view'
      config:
        clientRowOnly: true
