{
  "name": "@melite-plugin/dsh-gallery",
  "version": "0.2.3-rc.4",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "external": [
        "@melite/card-base/client",
        "@melite/three-client/client"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:mesh-door": "vite build --config e2e/mesh-door/vite.config.mts",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.client.json"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-client-connection": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.2-rc.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@playwright/test": "^1.65.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "lightningcss": "^1.33.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsdown": "^0.22.14",
    "typescript": "~5.7.3",
    "unrun": "^0.3.1",
    "vite": "^8.3.8"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh": ">=0.2.2-rc.5 <0.3.0",
    "react": "^19.2.6"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@melite/card-base": "workspace:*",
    "@melite/catalog": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/estate-queue": "workspace:*",
    "@melite/formats": "workspace:*",
    "@melite/three-client": "workspace:*"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.module.css",
    "cordis.patch.yml"
  ],
  "description": "The DSH web GUI's media sidebar — one Media tab over same-origin run-artifact and draft routes served by its host half.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayDataEngineer/melite.git",
    "directory": "packages/web/infer-gallery"
  },
  "keywords": [
    "melite",
    "comfyui",
    "cordis",
    "agent",
    "media-generation",
    "dsh-bundle"
  ]
}
