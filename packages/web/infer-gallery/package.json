{
  "name": "@melite-plugin/dsh-gallery",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./drilldown": "./src/drilldown.tsx"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "external": [
        "@melite/card-base/client"
      ]
    }
  },
  "scripts": {
    "build": "pnpm exec tsdown -c tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "build:mesh-door": "vite build --config e2e/mesh-door/vite.config.mts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "lightningcss": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsdown": "^0.22.14",
    "typescript": "~5.7.2",
    "unrun": "^0.3.1",
    "vite": "^8.2.2"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0",
    "react": "^19.2.6"
  },
  "dependencies": {
    "@melite/card-base": "workspace:*",
    "@melite/catalog": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/formats": "workspace:*",
    "three": "^0.184.0"
  }
}
