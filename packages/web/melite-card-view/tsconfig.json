{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    // STRICT SINCE the audit's gate hole (2026-10-10): this was the
    // only package in the estate with the whole lax triple off —
    // its sources were typed by nothing that could catch a null
    // deref or an implicit any. src/old stays excluded (history).
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": [
      "node"
    ],
    "paths": {
      "@/*": [
        "./src/old/*"
      ],
      "react": [
        "./node_modules/@types/react"
      ],
      "react/*": [
        "./node_modules/@types/react/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ],
      "react-dom/*": [
        "./node_modules/@types/react-dom/*"
      ],
      "three": [
        "./node_modules/@types/three"
      ],
      "three/examples/*": [
        "./node_modules/@types/three/examples/*",
        "./node_modules/three/examples/*"
      ]
      // NOTE: no @react-three/* pins (a fiber .d.ts pin once pointed
      // the BUNDLER at types — tsdown honors tsconfig paths — killing
      // the build with UNRESOLVED_IMPORT once the studio glob pulled
      // fiber into the graph; natural resolution serves both tsc and
      // the bundler here)
    },
    "strictFunctionTypes": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "lib",
    "src/old",
    "src/client/old-flow.css"
  ]
}
