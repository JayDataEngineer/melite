# LOCAL OVERLAY TEMPLATE — copy to the same name without .example and replace
# $MELITE_REPO with this repo's absolute path. The dsh loader resolves HOST-row
# entry paths against the profile dir, so real paths MUST be absolute — which
# is exactly why the real file is gitignored (privacy hook: /home/<user>).

# W3 STRETCH overlay (disposable): same two melite-card-view rows as
# test-overlay.yml PLUS the melite-tools host row, so a real chat turn can call
# the flow_start wire tool and the keyed card can render against it.
# Port 3087; never touches the live :3080 or the verified :3083 instance.
#
#   DSH_HOME=/tmp/melite-dsh-home dsh --profile web \
#     --patch $MELITE_REPO/dsh/melite-card-view/test-overlay-chat.yml --port 3087

- id: webserver
  config:
    host: 127.0.0.1
    port: 3087

- insert:
    - id: melite-card-view-host
      name: $MELITE_REPO/dsh/melite-card-view/lib/index.js
      config:
        gatewayUrl: ''  # the lanes answer in-process (R5); cross-host names the owning DSH
    - id: melite-tools
      name: $MELITE_REPO/dsh/melite-tools/lib/index.mjs
      config:
        gatewayUrl: ''  # the lanes answer in-process (R5); cross-host names the owning DSH
    - id: melite-card-view-client
      name: '@melite-plugin/dsh-card-view'
      config:
        clientRowOnly: true
