{
  "name": "@melite-plugin/dsh-card-view",
  "version": "0.3.1",
  "type": "module",
  "private": true,
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client/index.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-gateway"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-gateway/client",
        "@melite/card-base/client"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-resources": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1",
    "@melite/catalog": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/formats": "workspace:*",
    "@melite/image-mask-studio": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "clsx": "^2.1.1",
    "happy-dom": "^20.10.2",
    "lightningcss": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0",
    "react": "^19.2.6"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@melite-plugin/dsh-gallery": "workspace:*",
    "@melite-plugin/melite-run-wire": "workspace:*",
    "@melite-plugin/timeline": "workspace:*",
    "@melite/card-base": "workspace:*",
    "@melite/estate-drafts": "workspace:*",
    "@melite/estate-manage": "workspace:*",
    "@melite/estate-media": "workspace:*",
    "@melite/estate-runs": "workspace:*",
    "@melite/video-h3-timeline": "workspace:*",
    "three": "^0.184.0"
  },
  "sideEffects": true,
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.module.css"
  ]
}
