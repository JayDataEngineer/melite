{
  "name": "@melite-plugin/dsh-card-view",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-api-gateway"
      ],
      "platform": "web",
      "external": [
        "@deepseek-ai/dsh-api-gateway/client",
        "@melite/card-base"
      ]
    }
  },
  "scripts": {
    "build": "bun node_modules/tsdown/dist/run.mjs -c tsdown.config.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-connection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-resources": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1",
    "@melite/card-base": "workspace:*",
    "@melite/catalog": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/formats": "workspace:*",
    "@melite/image-mask-studio": "workspace:*",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/cli": "^4.3.3",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "clsx": "^2.1.1",
    "happy-dom": "^20.10.2",
    "lightningcss": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tsdown": "^0.22.14",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0",
    "react": "^19.2.6"
  },
  "dependencies": {
    "@deepseek-ai/dsh-api-gateway": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1",
    "@melite-plugin/dsh-gallery": "workspace:*",
    "@melite-plugin/melite-run-wire": "workspace:*",
    "@melite-plugin/timeline": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/estate-drafts": "workspace:*",
    "@melite/estate-media": "workspace:*",
    "@melite/estate-runs": "workspace:*",
    "@melite/video-h3-timeline": "workspace:*",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "three": "^0.184.0",
    "zod": "4.5.4"
  },
  "sideEffects": true
}
