    "mask": {
      "uid": 19,
      "refs": {
        "0": {
          "type": "any",
          "meta": {
            "description": "Mask Bag",
            "extra": {
              "wtype": "mask",
              "group": "mask",
              "zone": "mods",
              "order": -1,
              "tooltip": "The mask mod bag — ONE entry: { input_image?, input_mask, mask_mode, mask_* }. No inner \"mask\" field exists: the painted region rides input_mask (an RGBA PNG path); the base to inpaint on rides input_image (a photograph); to edit a photo by instruction use the image-edit card."
            }
          }
        },
        "1": {
          "type": "string",
          "meta": {
            "role": "path",
            "extra": {
              "wtype": "image",
              "group": "input",
              "zone": "inputs",
              "order": -2,
              "width": 1,
              "columns": 3,
              "tooltip": "The base to inpaint on (a photograph). With a region stated (input_mask or a detector) the detailer reworks THAT image's region — no generation composes. Unstated: the base is the render itself."
            },
            "description": "Region Base Image"
          }
        },
        "2": {
          "type": "string",
          "meta": {
            "role": "path",
            "extra": {
              "wtype": "image",
              "group": "input",
              "zone": "inputs",
              "order": -1,
              "width": 1,
              "columns": 3,
              "tooltip": "RGBA PNG whose alpha channel marks the region. On its own: the mask selects this entry's region. With crop_stitch: the detailer crops, edits, and composites the region back."
            },
            "description": "Region Mask"
          }
        },
        "3": {
          "type": "const",
          "meta": {},
          "value": "auto"
        },
        "4": {
          "type": "const",
          "meta": {},
          "value": "crop_stitch"
        },
        "5": {
          "type": "const",
          "meta": {},
          "value": "full_frame"
        },
        "6": {
          "type": "union",
          "meta": {
            "default": "crop_stitch",
            "description": "Edit Scope",
            "extra": {
              "wtype": "select",
              "group": "mask",
              "zone": "mods",
              "order": 1,
              "width": 1,
              "options": [
                {
                  "value": "auto",
                  "label": "Whole image (default)"
                },
                {
                  "value": "crop_stitch",
                  "label": "Masked region (crop + stitch)"
                }
              ],
              "tooltip": "No mask modifier = whole-image editing by default. Add a mask modifier to choose Masked region (crop + stitch): crop the region, edit it, and composite it back."
            }
          },
          "list": [
            3,
            4,
            5
          ]
        },
        "7": {
          "type": "const",
          "meta": {},
          "value": "off"
        },
        "8": {
          "type": "const",
          "meta": {},
          "value": "person"
        },
        "9": {
          "type": "const",
          "meta": {},
          "value": "face"
        },
        "10": {
          "type": "const",
          "meta": {},
          "value": "hand"
        },
        "11": {
          "type": "union",
          "meta": {
            "default": "off",
            "description": "Region Detector",
            "extra": {
              "wtype": "select",
              "group": "mask",
              "zone": "mods",
              "order": 2,
              "width": 1,
              "options": [
                "off",
                "person",
                "face",
                "hand"
              ],
              "tooltip": "Automated region source for crop_stitch (the Impact detectors): person = segmentation silhouette, face/hand = boxes. off = use the Region Mask."
            }
          },
          "list": [
            7,
            8,
            9,
            10
          ]
        },
        "12": {
          "type": "number",
          "meta": {
            "min": 0,
            "max": 256,
            "step": 8,
            "default": 64,
            "description": "Context Padding",
            "extra": {
              "wtype": "slider",
              "group": "mask",
              "zone": "mods",
              "order": 3,
              "width": 1,
              "tooltip": "Pixels of surrounding context kept in the crop (crop_stitch mode). More context = more coherence; 64 is the sweet spot."
            }
          }
        },
        "13": {
          "type": "number",
          "meta": {
            "min": -32,
            "max": 32,
            "step": 1,
            "default": 8,
            "description": "Grow / Shrink",
            "extra": {
              "wtype": "slider",
              "group": "mask",
              "zone": "mods",
              "order": 4,
              "width": 1,
              "tooltip": "Expand (+) or shrink (−) the region by an exact pixel disk before the run. Applied host-side."
            }
          }
        },
        "14": {
          "type": "number",
          "meta": {
            "min": 0,
            "max": 32,
            "step": 1,
            "default": 8,
            "description": "Feather",
            "extra": {
              "wtype": "slider",
              "group": "mask",
              "zone": "mods",
              "order": 5,
              "width": 1,
              "tooltip": "Gaussian falloff the composite blends through — kills the pasted-on rectangle edge."
            }
          }
        },
        "15": {
          "type": "number",
          "meta": {
            "min": 0,
            "max": 1,
            "step": 0.05,
            "default": 0,
            "description": "Re-threshold",
            "extra": {
              "wtype": "slider",
              "group": "mask",
              "zone": "mods",
              "order": 6,
              "width": 1,
              "tooltip": "Re-binarize the feathered mask at this level. 0 = keep the soft falloff."
            }
          }
        },
        "16": {
          "type": "boolean",
          "meta": {
            "default": false,
            "description": "Invert",
            "extra": {
              "wtype": "boolean",
              "group": "mask",
              "zone": "mods",
              "order": 7,
              "width": 1,
              "tooltip": "Work OUTSIDE the painted region instead."
            }
          }
        },
        "17": {
          "type": "number",
          "meta": {
            "min": 64,
            "max": 16384,
            "step": 8,
            "default": 512,
            "description": "Region Detail Size",
            "extra": {
              "wtype": "number",
              "group": "mask",
              "zone": "mods",
              "order": 8,
              "width": 1,
              "tooltip": "Working size the region detailer scales each region toward (DetailerForEach guide_size with bbox sizing, capped by the canonical max 1024)."
            }
          }
        },
        "18": {
          "type": "number",
          "meta": {
            "min": 0.05,
            "max": 1,
            "step": 0.05,
            "default": 1,
            "description": "Region Denoise",
            "extra": {
              "wtype": "number",
              "group": "mask",
              "zone": "mods",
              "order": 9,
              "width": 1,
              "tooltip": "How strongly the region is reworked (DetailerForEach denoise): 1 fully rewrites the crop — the default, so the requested edit lands; lower it explicitly only to keep more of the original pixels."
            }
          }
        },
        "19": {
          "type": "object",
          "meta": {
            "default": {}
          },
          "dict": {
            "mask": 0,
            "input_image": 1,
            "input_mask": 2,
            "mask_mode": 6,
            "mask_detector": 11,
