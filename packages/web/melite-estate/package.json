{
  "name": "@melite-plugin/dsh-estate",
  "private": true,
  "version": "0.4.0-alpha.3",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/comfyui-cordis": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/engine-agent": "workspace:*",
    "@melite/engine-contract": "workspace:*",
    "@melite/engine-craft": "workspace:*",
    "@melite/engine-mcp": "workspace:*",
    "@melite/estate-drafts": "workspace:*",
    "@melite/estate-manage": "workspace:*",
    "@melite/estate-media": "workspace:*",
    "@melite/estate-models": "workspace:*",
    "@melite/estate-provisioning": "workspace:*",
    "@melite/estate-queue": "workspace:*",
    "@melite/estate-runs": "workspace:*",
    "@melite/models-krea-2": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@melite/card-base": "workspace:*",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ]
}
