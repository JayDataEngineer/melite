{
  "name": "@melite/estate-media",
  "version": "0.3.0-rc.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "typert": "node scripts/typert.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@melite/contracts": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-host-webserver": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-generator": "0.2.2-rc.5",
    "@types/node": "^22.20.5",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/index.d.ts",
    "lib/index.js",
    "lib/typert.host.d.ts",
    "lib/typert.host.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "lib/typert.remote-client.js"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0"
  },
  "license": "AGPL-3.0-or-later",
  "description": "The runs media route \u2014 serves run artifacts same-origin under the DSH origin with realpath containment, plus its Typert remote.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayDataEngineer/melite.git",
    "directory": "packages/estate/media"
  },
  "keywords": [
    "melite",
    "comfyui",
    "cordis",
    "agent",
    "media-generation",
    "library"
  ]
}
