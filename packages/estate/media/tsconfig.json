{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2023"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "noEmit": false,
    // (the audit's hole: without this a RED build still emitted lib —
    // the ship's failure exit came after the damage was on disk)
    "noEmitOnError": true,
    "outDir": "lib",
    "declaration": true,
    "skipLibCheck": true,
    "rootDir": "src"
  },
  "include": [
    "src/**/*.ts"
  ]
}
