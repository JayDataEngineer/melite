{
  "name": "@melite/estate-drafts",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "REBUILD-1 (2026-09-10): the drafts domain as a DSH-native Typert Remote owner. Draft list/get over the host's storageDomain facility \u2014 no routes, no lanes, no second process. Follows references/deepseek-harness/docs/cookbook/adding-a-remote-api.md.",
  "main": "./lib/index.js",
  "files": [
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts",
    "lib/typert.remote-client.d.ts.map",
    "lib/index.js",
    "lib/index.d.ts",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-storage": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.1",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/contracts": "workspace:*",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-typert-generator": "0.2.0-rc.1",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typert": "node scripts/typert.mjs",
    "typecheck": "tsc --noEmit"
  }
}
