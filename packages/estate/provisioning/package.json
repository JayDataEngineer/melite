{
  "name": "@melite/estate-provisioning",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "Cordis provisioning service definition and provider for declared model and extension resources.",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "pnpm --dir ../../.. exec vitest run --project node packages/estate/provisioning/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-atomic-write": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.1",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
