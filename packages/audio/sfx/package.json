{
  "version": "0.4.0-alpha.7",
  "private": true,
  "type": "module",
  "description": "the sfx card (the audio lane) \u2014 one card one package: card.ts host face + ui/ studio + agents/ context",
  "exports": {
    ".": {
      "types": "./lib/card.d.ts",
      "default": "./lib/card.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/comfyui-cordis": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/models-moss-sfx": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "name": "@melite/audio-sfx",
  "files": [
    "lib/card.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
