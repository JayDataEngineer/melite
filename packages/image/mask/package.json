{
  "name": "@melite/image-mask",
  "version": "0.1.4-alpha",
  "private": true,
  "license": "SSPL-1.0",
  "type": "module",
  "description": "the mask card (the image lane) — MASK as a simple form card with MODs as ways to get different kinds of masks (dev_docs/design/mods-contracts.md)",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./card": {
      "types": "./lib/card.d.ts",
      "default": "./lib/card.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/models-mask": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "~6.0.3",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
