{
  "version": "0.2.0-alpha",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "Leaf-face carrier of the retired mask card's studio surfaces — paint and bbox canvases embedded in modifier leaves.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./paint-canvas": {
      "types": "./lib/ui/PaintLeafCanvas.d.ts",
      "default": "./lib/ui/PaintLeafCanvas.js"
    },
    "./bbox-canvas": {
      "types": "./lib/ui/BboxLeafCanvas.d.ts",
      "default": "./lib/ui/BboxLeafCanvas.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@melite/contracts": "workspace:*",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "*",
    "@testing-library/user-event": "*",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "name": "@melite/image-mask-studio",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.css",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.module.css"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JayDataEngineer/melite.git",
    "directory": "packages/image/mask-studio"
  },
  "keywords": [
    "melite",
    "comfyui",
    "cordis",
    "agent",
    "media-generation",
    "library"
  ]
}
