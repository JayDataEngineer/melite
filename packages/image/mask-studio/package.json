{
  "version": "0.1.4-alpha",
  "private": true,
  "license": "SSPL-1.0",
  "type": "module",
  "description": "the mask-studio carrier, DEMOTED (CONTRACT D — the card retired at parity): ui/ survives as the leaf-face carrier (paint + bbox); the takeover client is gone",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./paint-canvas": {
      "types": "./lib/ui/PaintLeafCanvas.d.ts",
      "default": "./lib/ui/PaintLeafCanvas.js"
    },
    "./bbox-canvas": {
      "types": "./lib/ui/BboxLeafCanvas.d.ts",
      "default": "./lib/ui/BboxLeafCanvas.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@melite/contracts": "workspace:*",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "*",
    "@testing-library/user-event": "*",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "name": "@melite/image-mask-studio",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.css",
    "lib/**/*.d.ts",
    "lib/**/*.js",
    "lib/**/*.module.css"
  ]
}
