{
  "version": "0.1.5-pre-alpha",
  "private": true,
  "license": "SSPL-1.0",
  "type": "module",
  "description": "the rig card (the 3d lane) — skeleton + weights on any GLB: SOMA-77 auto (humanoid), rig-copy (donor→target), species (anyCreature bridge)",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./card": {
      "types": "./lib/card.d.ts",
      "default": "./lib/card.js"
    },
    "./validate-rig-report": {
      "types": "./lib/validateRigReport.d.ts",
      "default": "./lib/validateRigReport.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/models-anycreature": "workspace:*",
    "@melite/models-gem_soma": "workspace:*",
    "@melite/models-transfer_rig": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "name": "@melite/3d-rig",
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
