{
  "version": "0.2.0-alpha",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "the img-to-mesh card (the 3d lane) — one card one package: card.ts host face + agents/ context (no tool face, no ui/ — the view is constructed by @melite/card-base from the emission)",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./card": {
      "types": "./lib/card.d.ts",
      "default": "./lib/card.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5",
    "@melite-plugin/melite-run-wire": "workspace:*",
    "@melite/card-base": "workspace:*",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/models-pixal3d": "workspace:*",
    "@melite/models-transfer-rig": "workspace:*",
    "@melite/models-trellis2-native": "workspace:*",
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "*",
    "@testing-library/user-event": "*",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3",
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "name": "@melite/3d-img-to-mesh",
  "dsh": {
    "client": {
      "platform": "web",
      "external": [
        "@melite/card-base/client"
      ]
    }
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  }
}
