{
  // The vendored protocol's build face — mirrors the estate's tsc
  // package shape (drafts/store): emit lib/ + declaration maps from
  // src, NodeNext module law. The DSH source imports carry no .js
  // extensions (their repo builds with bundler-flavored settings);
  // moduleResolution Bundler keeps the copied source VERBATIM (the
  // vendor law: no source edits — the only authored files here are
  // this config and the manifest).
  "compilerOptions": {
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "outDir": "lib",
    // (the audit's hole: without this a RED build still emitted lib —
    // the ship's failure exit came after the damage was on disk)
    "noEmitOnError": true,
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
