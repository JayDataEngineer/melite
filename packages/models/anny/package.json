{
  "name": "@melite/models-anny",
  "version": "0.2.0-alpha",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./mods/verbs": {
      "types": "./lib/mods/verbs.d.ts",
      "default": "./lib/mods/verbs.js"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build-mods.json && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "description": "Anny 3D character-assembly family, identity-slider body baking with turnaround sheets and sub-action verbs.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayDataEngineer/melite.git",
    "directory": "packages/models/anny"
  },
  "keywords": [
    "melite",
    "comfyui",
    "cordis",
    "agent",
    "media-generation",
    "library"
  ]
}
