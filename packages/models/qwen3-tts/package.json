{
  "name": "@melite/models-qwen3-tts",
  "version": "0.2.0-alpha",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./mods/qvoice": {
      "types": "./lib/mods/qvoice.d.ts",
      "default": "./lib/mods/qvoice.js"
    },
    "./mods/qvoice_save": {
      "types": "./lib/mods/qvoice_save.d.ts",
      "default": "./lib/mods/qvoice_save.js"
    }
  },
  "dependencies": {
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/engine-contract": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build-mods.json && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "description": "Qwen3-TTS 0.6B text-to-speech family — preset-persona and reference-clone speech plus persona (.qvoice) export, on the ComfyUI engine.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayDataEngineer/melite.git",
    "directory": "packages/models/qwen3-tts"
  },
  "keywords": [
    "melite",
    "comfyui",
    "cordis",
    "agent",
    "media-generation",
    "library"
  ]
}
