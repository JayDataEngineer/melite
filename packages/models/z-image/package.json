{
  "name": "@melite/models-z-image",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./mods/loras": {
      "types": "./lib/mods/loras.d.ts",
      "default": "./lib/mods/loras.js"
    },
    "./mods/controlnet": {
      "types": "./lib/mods/controlnet.d.ts",
      "default": "./lib/mods/controlnet.js"
    },
    "./mods/ip_adapter": {
      "types": "./lib/mods/ip_adapter.d.ts",
      "default": "./lib/mods/ip_adapter.js"
    }
  },
  "dependencies": {
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/comfyui-cordis": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build-mods.json && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  }
}
