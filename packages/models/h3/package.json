{
  "name": "@melite/models-h3",
  "version": "0.2.0-alpha",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./mods/loras": {
      "types": "./lib/mods/loras.d.ts",
      "default": "./lib/mods/loras.js"
    },
    "./timelineContract": {
      "types": "./lib/timelineContract.d.ts",
      "default": "./lib/timelineContract.js"
    },
    "./filmMix": {
      "types": "./lib/filmMix.d.ts",
      "default": "./lib/filmMix.js"
    },
    "./actions": {
      "types": "./lib/actions.d.ts",
      "default": "./lib/actions.js"
    },
    "./schema": {
      "types": "./lib/schema.d.ts",
      "default": "./lib/schema.js"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cosmokit": "~1.8.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build-mods.json && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/cosmokit": "~1.8.5"
  },
  "description": "MiniMax H3 family, joint video and audio generation across timeline, single-shot, and keyframe lanes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayDataEngineer/melite.git",
    "directory": "packages/models/h3"
  },
  "keywords": [
    "melite",
    "comfyui",
    "cordis",
    "agent",
    "media-generation",
    "library"
  ]
}
