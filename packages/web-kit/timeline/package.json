{
  "name": "@melite-plugin/timeline",
  "version": "0.1.5-pre-alpha",
  "type": "module",
  "types": "./src/timeline/index.ts",
  "exports": {
    "./ui/timeline": {
      "types": "./lib/timeline/index.d.ts",
      "default": "./lib/timeline/index.js"
    },
    "./ui/store": {
      "types": "./lib/store/index.d.ts",
      "default": "./lib/store/index.js"
    },
    "./ui/playback": {
      "types": "./lib/playback/index.d.ts",
      "default": "./lib/playback/index.js"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@melite/catalog": "workspace:*",
    "@melite/card-base": "workspace:*",
    "@melite/contracts": "workspace:*",
    "clsx": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/react": "*",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^22.20.0",
    "@types/react": "^19.3.0",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.module.css"
  ],
  "melite": {
    "publish": {
      "subpathOnly": true,
      "reason": "UI library imported through its ui/* subpaths and inlined by consumer client bundles — no plugin, no loader face (F1 demotion, nativity audit 2026-11-05)"
    }
  },
  "license": "SSPL-1.0"
}
