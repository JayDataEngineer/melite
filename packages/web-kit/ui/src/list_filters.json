{
  "schema_version": 1,
  "kinds": {
    "media": {
      "kind": "media",
      "label": "Media",
      "icon": "Image",
      "supports": ["search", "kind", "tag", "fav"],
      "default_sort": "newest"
    },
    "flow": {
      "kind": "flow",
      "label": "Flows",
      "icon": "Workflow",
      "supports": ["search", "provenance", "tag", "fav"],
      "default_sort": "recent"
    },
    "card": {
      "kind": "card",
      "label": "Cards",
      "icon": "Layers",
      "supports": ["search", "provenance", "kind", "tag"],
      "default_sort": "recent"
    },
    "thread": {
      "kind": "thread",
      "label": "History",
      "icon": "MessageSquare",
      "supports": ["search", "tag", "fav"],
      "default_sort": "recent"
    }
  },
  "sort_options": {
    "newest":   { "field": "createdAt", "order": "desc", "rule": "value",    "label": "Newest" },
    "oldest":   { "field": "createdAt", "order": "asc",  "rule": "value",    "label": "Oldest" },
    "recent":   { "field": "updatedAt", "order": "desc", "rule": "value",    "label": "Recent" },
    "name-az":  { "field": "name",      "order": "asc",  "rule": "value",    "label": "A–Z" },
    "name-za":  { "field": "name",      "order": "desc", "rule": "value",    "label": "Z–A" },
    "favorites":{ "field": "fav",       "order": "desc", "rule": "boolean",  "label": "Favorites" },
    "largest":  { "field": "size",      "order": "desc", "rule": "value",    "label": "Largest" }
  }
}
