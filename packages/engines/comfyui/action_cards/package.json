{
  "name": "@melite/cards",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The comfyui engine's card tenants (React studio forms). Scoped as a package so card files resolve the shared kit (@melite/* from packages/web/ui_components), the engine UI tenants (@melite-plugin/*), and their runtime deps. Cards are loaded by the editor registry by FILE glob; this package exists for module resolution, typecheck, and dependency hygiene.",
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.5-rc.2",
    "@melite-plugin/3d": "workspace:*",
    "@melite-plugin/motion": "workspace:*",
    "@melite-plugin/timeline": "workspace:*",
    "@melite/catalog": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/formats": "workspace:*",
    "@melite/slots": "workspace:*",
    "@react-three/drei": "*",
    "@react-three/fiber": "*",
    "clsx": "*",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./3d/*": "./3d/*",
    "./package.json": "./package.json",
    "./3d/body/ui/studio/bodyStudio": "./3d/body/ui/studio/bodyStudio.ts",
    "./3d/body/ui/studio/BodyShapePanel": "./3d/body/ui/studio/BodyShapePanel.tsx",
    "./3d/body/ui/studio/MeshPreviewCanvas": "./3d/body/ui/studio/MeshPreviewCanvas.tsx"
  }
}
