{
  "name": "@melite-plugin/3d",
  "version": "0.1.1",
  "type": "module",
  "types": "./viewers/index.ts",
  "exports": {
    "./package.json": "./package.json",
    "./ui/railTabs": {
      "types": "./lib/railTabs.d.ts",
      "default": "./lib/railTabs.js"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@melite/catalog": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/formats": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "*",
    "@melite/cards": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "^19"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.module.css"
  ],
  "melite": {
    "publish": {
      "subpathOnly": true,
      "reason": "cordis plugin loaded by the host runtime, not imported by root"
    }
  }
}
