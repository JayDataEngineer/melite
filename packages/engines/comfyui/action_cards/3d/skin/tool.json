[
  {
    "name": "skin_card",
    "version": 1,
    "kind": "card-compose",
    "card": "skin",
    "model": "skin",
    "stage_title": "Skin",
    "description": "Deterministic skin detail maps onto a SOMAX body (kind sidecar + proof turnaround).",
    "params_schema": {
      "type": "object",
      "properties": {
        "body_glb": {
          "type": "string",
          "format": "path",
          "description": "Body GLB"
        },
        "kind": {
          "type": "string",
          "enum": [
            "keeper",
            "villager",
            "villager_elder",
            "ash_nomad",
            "caravan_trader",
            "arena_factor",
            "amf_warden",
            "marrow_raider",
            "dune_hound",
            "sand_skimmer",
            "ridge_lizard",
            "moss_elk",
            "gloom_tortoise",
            "emberwing",
            "bone_crane",
            "husk_stalker",
            "ironvein_construct",
            "cherusci_scrivener",
            "amalgam_horror",
            "meld_creature"
          ],
          "default": "keeper",
          "description": "Kind"
        },
        "map_size": {
          "type": "string",
          "enum": [
            "256",
            "512",
            "1024",
            "2048"
          ],
          "default": "512",
          "description": "Map size"
        },
        "seed": {
          "type": "number",
          "minimum": 0,
          "maximum": 2147483647,
          "default": 20260906,
          "description": "Seed"
        },
        "resolution": {
          "type": "number",
          "minimum": 256,
          "maximum": 2048,
          "default": 768,
          "description": "View resolution"
        },
        "framing": {
          "type": "number",
          "minimum": 1.0,
          "maximum": 3.0,
          "default": 1.2,
          "description": "Framing"
        },
        "focal_length": {
          "type": "number",
          "minimum": 18,
          "maximum": 135,
          "default": 50,
          "description": "Focal length"
        },
        "samples": {
          "type": "number",
          "minimum": 8,
          "maximum": 256,
          "default": 64,
          "description": "Samples"
        },
        "transparent": {
          "type": "string",
          "enum": [
            "true",
            "false"
          ],
          "default": "true",
          "description": "Transparent"
        }
      },
      "required": [
        "body_glb"
      ]
    }
  }
]
