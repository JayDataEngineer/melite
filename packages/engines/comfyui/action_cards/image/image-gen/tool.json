[
  {
    "name": "image_gen_card",
    "version": 1,
    "kind": "card-compose",
    "card": "image-gen",
    "model": "krea-2",
    "stage_title": "Image",
    "description": "Text-to-image generation — the generate_image interface card boarding krea-2; the family declares its mods (loras) and the surface scopes itself",
    "params_schema": {
      "type": "object",
      "properties": {
        "model": {
          "type": "string",
          "enum": [
            "krea-2",
            "z-image",
            "anima"
          ],
          "description": "The boarded family to run — the request's top-level `model`. Options: krea-2, z-image, anima.",
          "default": "krea-2"
        },
        "prompt": {
          "type": "string",
          "description": "Prompt"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Negative Prompt"
        },
        "width": {
          "type": "number",
          "minimum": 256,
          "maximum": 2048,
          "default": 1024,
          "description": "Width"
        },
        "height": {
          "type": "number",
          "minimum": 256,
          "maximum": 2048,
          "default": 1024,
          "description": "Height"
        },
        "seed": {
          "type": "integer",
          "default": -1,
          "description": "Seed"
        },
        "steps": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 8,
          "description": "Steps"
        },
        "cfg": {
          "type": "number",
          "minimum": 1,
          "maximum": 20,
          "default": 4.5,
          "description": "How closely the diffusion follows the prompt. Higher = stricter."
        },
        "sampler": {
          "type": "string",
          "description": "Sampler — options resolve from the $samplers vocabulary at serve time"
        },
        "scheduler": {
          "type": "string",
          "description": "Scheduler — options resolve from the $schedulers vocabulary at serve time"
        },
        "loras": {
          "type": "array",
          "description": "LoRAs",
          "x-families": [
            "krea-2"
          ]
        }
      },
      "required": [
        "prompt"
      ]
    }
  }
]
