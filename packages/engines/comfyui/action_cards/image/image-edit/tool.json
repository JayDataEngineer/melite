[
  {
    "name": "image_edit_card",
    "version": 1,
    "kind": "card-compose",
    "card": "image-edit",
    "model": "qwen-img-edit-2511",
    "stage_title": "Image Edit",
    "description": "Instruction-driven image editing — the edit_image interface card boarding the Qwen-Image-Edit 2511 lane; the family carries the lightning / standard cascade (variant/quant always shown) plus the lanpaint flavor (required anchor image). The surface scopes itself.",
    "params_schema": {
      "type": "object",
      "properties": {
        "image2": {
          "type": "string",
          "format": "path",
          "description": "Image 2"
        },
        "image3": {
          "type": "string",
          "format": "path",
          "description": "Image 3"
        },
        "reference_images": {
          "type": "array",
          "default": [],
          "description": "Multi-image picker (up to 3). Used by workflows that pass resolved image lists; complements the individual Image 2 / Image 3 slots above."
        },
        "prompt": {
          "type": "string",
          "description": "Prompt"
        },
        "negative_prompt": {
          "type": "string",
          "description": "Negative Prompt"
        },
        "seed": {
          "type": "integer",
          "default": -1,
          "description": "Seed"
        },
        "steps": {
          "type": "number",
          "minimum": 1,
          "maximum": 50,
          "default": 4,
          "description": "Steps"
        },
        "cfg": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 10,
          "default": 1.0,
          "description": "Qwen-Image-Edit uses low CFG (flow-matching)."
        },
        "sampler": {
          "type": "string",
          "description": "Sampler — options resolve from the $samplers vocabulary at serve time"
        },
        "scheduler": {
          "type": "string",
          "description": "Scheduler — options resolve from the $schedulers vocabulary at serve time"
        },
        "use_stock_nodes": {
          "type": "boolean",
          "default": false,
          "description": "When true, build_img2img_edit emits the stock Qwen-Image-Edit node graph (no DiffSynth patches, no custom ControlNet wiring). Useful for reproducing upstream behavior exactly."
        },
        "double_reference": {
          "type": "boolean",
          "default": false,
          "description": "Encode the input image twice (VAE + vision encoder) for stronger identity preservation. Disable for faster runs where identity drift is acceptable."
        },
        "image1": {
          "type": "string",
          "format": "path",
          "description": "Image 1"
        },
        "lanpaint_enabled": {
          "type": "boolean",
          "default": false,
          "x-visible-when": "image1 != null",
          "description": "Force LanPaint"
        },
        "lanpaint_num_steps": {
          "type": "number",
          "minimum": 1,
          "maximum": 100,
          "default": 20,
          "x-visible-when": "lanpaint_enabled == true",
          "description": "Num Steps"
        },
        "lanpaint_step_size": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 2,
          "default": 1.0,
          "x-visible-when": "lanpaint_enabled == true",
          "description": "Step Size"
        },
        "lanpaint_lambda": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.5,
          "x-visible-when": "lanpaint_enabled == true",
          "description": "Lambda"
        },
        "lanpaint_beta": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.5,
          "x-visible-when": "lanpaint_enabled == true",
          "description": "Beta"
        },
        "lanpaint_friction": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.5,
          "x-visible-when": "lanpaint_enabled == true",
          "description": "Friction"
        },
        "lanpaint_prompt_mode": {
          "type": "string",
          "enum": [
            "negative",
            "positive"
          ],
          "default": "negative",
          "x-visible-when": "lanpaint_enabled == true",
          "description": "Prompt Mode"
        },
        "outpaint_top": {
          "type": "number",
          "minimum": 0,
          "maximum": 512,
          "default": 0,
          "x-visible-when": "image1 != null",
          "description": "Expand Top"
        },
        "outpaint_right": {
          "type": "number",
          "minimum": 0,
          "maximum": 512,
          "default": 0,
          "x-visible-when": "image1 != null",
          "description": "Expand Right"
        },
        "outpaint_bottom": {
          "type": "number",
          "minimum": 0,
          "maximum": 512,
          "default": 0,
          "x-visible-when": "image1 != null",
          "description": "Expand Bottom"
        },
        "outpaint_left": {
          "type": "number",
          "minimum": 0,
          "maximum": 512,
          "default": 0,
          "x-visible-when": "image1 != null",
          "description": "Expand Left"
        },
        "outpaint_overlap": {
          "type": "number",
          "minimum": 0,
          "maximum": 64,
          "default": 16,
          "x-visible-when": "image1 != null",
          "description": "Overlap"
        },
        "loras": {
          "type": "array",
          "description": "LoRAs"
        },
        "mask": {
          "type": "string",
          "description": "Add the mask mod, then drop an RGBA PNG whose alpha channel marks the region."
        },
        "input_mask": {
          "type": "string",
          "format": "path",
          "description": "RGBA PNG whose alpha channel marks the region. Standalone: region semantics for this lane. Alongside lanpaint: the inpaint region — present with image1, the builder switches to the lanpaint sampler."
        },
        "mask_mode": {
          "type": "string",
          "enum": [
            "auto",
            "crop_stitch",
            "full_frame"
          ],
          "default": "auto",
          "description": "How the mask is honored: auto (the lane's own region ControlNet if its weights are present, else crop+stitch), crop_stitch (crop to the mask + context, work the crop, composite back — pixels outside the mask never change), full_frame (legacy whole-image pass; unmasked regions may drift)."
        },
        "mask_context_pad": {
          "type": "number",
          "minimum": 0,
          "maximum": 256,
          "default": 64,
          "description": "Pixels of surrounding context kept in the crop (crop_stitch mode). More context = more coherence; 64 is the sweet spot."
        },
        "mask_grow": {
          "type": "number",
          "minimum": -32,
          "maximum": 32,
          "default": 8,
          "description": "Expand (+) or shrink (−) the region by an exact pixel disk before the run. Applied host-side."
        },
        "mask_feather": {
          "type": "number",
          "minimum": 0,
          "maximum": 32,
          "default": 8,
          "description": "Gaussian falloff the composite blends through — kills the pasted-on rectangle edge."
        },
        "mask_threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0,
          "description": "Re-binarize the feathered mask at this level. 0 = keep the soft falloff."
        },
        "mask_invert": {
          "type": "boolean",
          "default": false,
          "description": "Work OUTSIDE the painted region instead."
        }
      },
      "required": [
        "prompt",
        "image1"
      ]
    }
  }
]
