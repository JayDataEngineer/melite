[
  {
    "name": "voice_lock_card",
    "version": 1,
    "kind": "card-compose",
    "card": "voice-lock",
    "model": "qwen3-tts-voicedesign",
    "stage_title": "Voice Lock",
    "description": "Lock a voice persona — design, export, and reuse .qvoice embeddings for consistent character voices",
    "params_schema": {
      "type": "object",
      "properties": {
        "voice_name": {
          "type": "string",
          "description": "Name for the locked persona — becomes the .qvoice filename stem. Reused across every future TTS render."
        },
        "style_instruction": {
          "type": "string",
          "description": "The voice description — becomes the VoiceDesign prompt (e.g. 'A warm female voice with a British accent')."
        },
        "temperature": {
          "type": "number",
          "minimum": 0,
          "maximum": 2,
          "default": 0.7,
          "description": "Temperature"
        },
        "top_p": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.9,
          "description": "Top-P"
        },
        "speed": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 2,
          "default": 1.0,
          "description": "Speed"
        },
        "repetition_penalty": {
          "type": "number",
          "minimum": 0.8,
          "maximum": 2,
          "default": 1.05,
          "description": "Repetition Penalty"
        },
        "seed": {
          "type": "integer",
          "default": -1,
          "description": "Seed"
        }
      },
      "required": [
        "voice_name",
        "style_instruction"
      ]
    }
  }
]
