{
  "name": "@melite/cards",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "The comfyui engine's card tenants (React studio forms). Scoped as a package so card files resolve the shared kit (@melite/* from packages/web/ui_components), the engine UI tenants (@melite-plugin/*), and their runtime deps. Cards are loaded by the editor registry by FILE glob; this package exists for module resolution, typecheck, and dependency hygiene.",
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@melite-plugin/3d": "workspace:*",
    "@melite-plugin/motion": "workspace:*",
    "@melite-plugin/timeline": "workspace:*",
    "@melite/card-base": "workspace:*",
    "@melite/catalog": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/formats": "workspace:*",
    "clsx": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@melite/three-client": "workspace:*"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./form-fields": {
      "types": "./lib/form-fields.d.ts",
      "default": "./lib/form-fields.js"
    },
    "./poster-shell": {
      "types": "./lib/poster-shell.d.ts",
      "default": "./lib/poster-shell.js"
    },
    "./package.json": "./package.json"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "^19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.module.css"
  ]
}
