{
  "name": "@melite-plugin/motion",
  "version": "0.1.4-alpha",
  "type": "module",
  "types": "./viewers/index.ts",
  "exports": {
    "./ui/viewers": {
      "types": "./lib/viewers/index.d.ts"
    },
    "./ui/viewers/motionImageStore": {
      "types": "./lib/viewers/motionImageStore.d.ts"
    },
    "./package.json": "./package.json",
    "./ui/viewer3d": {
      "types": "./lib/viewer3d/index.d.ts"
    }
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@melite/card-base": "workspace:*",
    "@melite/catalog": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/formats": "workspace:*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@melite/cards": "workspace:*",
    "@melite/three-client": "workspace:*"
  },
  "devDependencies": {
    "@types/three": "^0.184.1",
    "@types/node": "22.20.1",
    "@types/react": "^19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build-viewers.json && tsc -p tsconfig.build.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.module.css"
  ],
  "melite": {
    "publish": {
      "subpathOnly": true,
      "reason": "cordis plugin loaded by the host runtime, not imported by root"
    }
  },
  "license": "SSPL-1.0"
}
