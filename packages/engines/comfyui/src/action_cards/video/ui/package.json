{
  "name": "@melite-plugin/video",
  "version": "0.1.4-alpha",
  "type": "module",
  "types": "./viewers/index.ts",
  "exports": {
    "./ui/viewers": {
      "types": "./lib/viewers/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@melite/contracts": "workspace:*",
    "lucide-react": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@melite/cards": "workspace:*"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build-viewers.json && tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "@types/react": "^19"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.module.css"
  ],
  "melite": {
    "publish": {
      "subpathOnly": true,
      "reason": "cordis plugin loaded by the host runtime, not imported by root"
    }
  },
  "license": "SSPL-1.0"
}
