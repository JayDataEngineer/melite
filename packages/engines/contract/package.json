{
  "name": "@melite/engine-contract",
  "version": "0.2.0-alpha",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "The engine Service Definition — the engines seat, engine-agnostic stage types, and the pinned engine-id vocabulary every engine adapter and the runs lane share.",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./engines": {
      "types": "./lib/engines.d.ts",
      "default": "./lib/engines.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./vocabulary": {
      "types": "./lib/vocabulary.d.ts",
      "default": "./lib/vocabulary.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JayDataEngineer/melite.git",
    "directory": "packages/engines/contract"
  },
  "keywords": [
    "melite",
    "comfyui",
    "cordis",
    "agent",
    "media-generation",
    "library"
  ]
}
