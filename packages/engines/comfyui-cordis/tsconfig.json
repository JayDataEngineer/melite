{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@deepseek-ai/cordis-plugin-loader": ["../../vendor/cordis_plugins/loader/lib/types"],
      "@deepseek-ai/cordis-plugin-timer": ["../../vendor/cordis_plugins/timer/lib/types"],
      "@deepseek-ai/cordis-plugin-logger-console": ["../../vendor/cordis_plugins/logger-console/lib/types"],
      "@deepseek-ai/cordis": ["./node_modules/@deepseek-ai/cordis/lib/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts"]
}
