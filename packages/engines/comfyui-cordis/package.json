{
  "name": "@melite/comfyui-cordis",
  "version": "0.1.5-pre-alpha",
  "private": true,
  "license": "SSPL-1.0",
  "type": "module",
  "description": "The comfyui engine's Cordis compose plane + models registry — one package, two services (ctx.models + ctx.comfyui). Runtime is node --experimental-strip-types (erasable-syntax TS); no build step. Cards are one-folder units (card-folder-shape design record): card.ts (host face) + ui/ (browser face — deps below exist for the studios' module resolution; the editor's vite/vitest compiles them, the engine tsc program excludes ui/) + agents/ (model context, served by the planes door).",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./catalog-registry": {
      "types": "./lib/entries/catalog-registry.d.ts",
      "default": "./lib/entries/catalog-registry.js"
    },
    "./cli": {
      "types": "./lib/cli.d.ts",
      "default": "./lib/cli.js"
    },
    "./comfyui-engine": {
      "types": "./lib/entries/comfyui-engine.d.ts",
      "default": "./lib/entries/comfyui-engine.js"
    },
    "./comfyui-host": {
      "types": "./lib/entries/comfyui-host.d.ts",
      "default": "./lib/entries/comfyui-host.js"
    },
    "./comfyui-wiring": {
      "types": "./lib/entries/comfyui-wiring.d.ts",
      "default": "./lib/entries/comfyui-wiring.js"
    },
    "./envelope-laws": {
      "types": "./lib/envelope-laws.d.ts",
      "default": "./lib/envelope-laws.js"
    },
    "./models-service": {
      "types": "./lib/models/service.d.ts",
      "default": "./lib/models/service.js"
    },
    "./package.json": "./package.json",
    "./provisioning-manifest": {
      "types": "./lib/scripts/provision-extensions-manifest.d.ts",
      "default": "./lib/scripts/provision-extensions-manifest.js"
    },
    "./service": {
      "types": "./lib/service.d.ts",
      "default": "./lib/service.js"
    },
    "./user-loras": {
      "types": "./lib/userLoras.d.ts",
      "default": "./lib/userLoras.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build-scripts.json && tsc -p tsconfig.build.json",
    "compose": "node --experimental-strip-types src/cli.ts",
    "regen:vocab": "node --experimental-strip-types scripts/regen-vocab.ts",
    "regen:object-info": "node --experimental-strip-types scripts/regen-object-info-min.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/dsh-settings": "0.2.1-rc.2",
