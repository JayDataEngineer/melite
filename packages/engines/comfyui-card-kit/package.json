{
  "name": "@melite/comfyui-card-kit",
  "version": "0.1.4-alpha",
  "private": true,
  "license": "SSPL-1.0",
  "type": "module",
  "description": "The compose kit — the named package deep card domains reach for instead of climbing (P46: 1:1 with the reference; ui-tool's toolviews imports @deepseek-ai/dsh-client-ui-primitives from depth, never a relative climb). Pure graph-compose functions: kit lanes, GraphBuilder, facts derivation, block/mod helpers, the ONE vocabulary. Runtime is node --experimental-strip-types (erasable-syntax TS); no build step.",
  "exports": {
    ".": {
      "types": "./lib/kit.d.ts",
      "default": "./lib/kit.js"
    },
    "./graph": {
      "types": "./lib/graph.d.ts",
      "default": "./lib/graph.js"
    },
    "./impact": {
      "types": "./lib/impact.d.ts",
      "default": "./lib/impact.js"
    },
    "./tts-segments": {
      "types": "./lib/tts-segments.d.ts",
      "default": "./lib/tts-segments.js"
    },
    "./facts": {
      "types": "./lib/facts.d.ts",
      "default": "./lib/facts.js"
    },
    "./fields": {
      "types": "./lib/fields.d.ts",
      "default": "./lib/fields.js"
    },
    "./vocab": {
      "types": "./lib/vocab.d.ts",
      "default": "./lib/vocab.js"
    },
    "./paramRows": {
      "types": "./lib/paramRows.d.ts",
      "default": "./lib/paramRows.js"
    },
    "./morphs": {
      "types": "./lib/morphs.d.ts",
      "default": "./lib/morphs.js"
    },
    "./guard": {
      "types": "./lib/mods/guard.d.ts",
      "default": "./lib/mods/guard.js"
    },
    "./package.json": "./package.json",
    "./card-definition": {
      "types": "./lib/card-definition.d.ts",
      "default": "./lib/card-definition.js"
    },
    "./model-contract": {
      "types": "./lib/model-contract.d.ts",
      "default": "./lib/model-contract.js"
    },
    "./service-faces": {
      "types": "./lib/service-faces.d.ts",
      "default": "./lib/service-faces.js"
    },
    "./admission": {
      "types": "./lib/admission.d.ts",
      "default": "./lib/admission.js"
    },
    "./errors": {
      "types": "./lib/errors.d.ts",
      "default": "./lib/errors.js"
    },
    "./params-emit": {
      "types": "./lib/params-emit.d.ts",
      "default": "./lib/params-emit.js"
    },
    "./semanticModelKnob": {
      "types": "./lib/semanticModelKnob.d.ts",
      "default": "./lib/semanticModelKnob.js"
    },
    "./linked": {
      "types": "./lib/linked.d.ts",
      "default": "./lib/linked.js"
    },
    "./pack-fields": {
      "types": "./lib/pack-fields.d.ts",
      "default": "./lib/pack-fields.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "@melite/contracts": "workspace:*",
    "@melite/engine-contract": "workspace:*",
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  },
  "files": [
    "lib/kit.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ]
}
