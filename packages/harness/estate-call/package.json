{
  "name": "@melite/estate-call",
  "version": "0.1.0-alpha.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/estateCall.d.ts",
      "default": "./lib/estateCall.js"
    },
    "./package.json": "./package.json",
    "./cardTool": {
      "types": "./lib/cardTool.d.ts",
      "default": "./lib/cardTool.js"
    },
    "./executorHarness": {
      "types": "./lib/executorHarness.d.ts",
      "default": "./lib/executorHarness.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1"
  },
  "files": [
    "lib/estateCall.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ]
}
