# LOCAL OVERLAY TEMPLATE — copy to the same name without .example and replace
# $MELITE_REPO with this repo's absolute path. The dsh loader resolves HOST-row
# entry paths against the profile dir, so real paths MUST be absolute — which
# is exactly why the real file is gitignored (privacy hook: /home/<user>).

# Estate boot-verification overlay — disposable port so the live GUI
# (:3080) is never touched. Mounts the estate row (in-process seats —
# there is no gateway, no :33081, no gatewayUrl) plus the tools' host
# ✦ doors over the web base. Entry paths are ABSOLUTE: the loader
# resolves relative names against the profile dir, not this file.
- id: webserver
  config:
    host: 127.0.0.1
    port: 3082

- insert:
    - id: melite-estate
      name: '@melite-plugin/dsh-estate'
    - id: melite-tools-doors
      name: '@melite/harness-tools/doors'
