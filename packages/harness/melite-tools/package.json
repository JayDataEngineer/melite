{
  "name": "@melite/harness-tools",
  "version": "0.3.0-rc.1",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json",
    "./doors": {
      "types": "./lib/doors.d.ts",
      "default": "./lib/doors.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test:smoke": "node tests/smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@types/node": "^22.20.5",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-attachment": "0.2.2-rc.5",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.5",
    "@deepseek-ai/dsh-session": "0.2.2-rc.5",
    "@deepseek-ai/dsh-timeout": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@deepseek-ai/dsh-typert-protocol": "0.2.2-rc.5",
    "@deepseek-ai/dsh-util-values": "0.2.2-rc.5",
    "@deepseek-ai/schemastery": "^3.19.0",
    "@melite/audio-music": "workspace:*",
    "@melite/audio-tts": "workspace:*",
    "@melite/card-base": "workspace:*",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/comfyui-cordis": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/engine-agent": "workspace:*",
    "@melite/engine-craft": "workspace:*",
    "@melite/engine-mcp": "workspace:*",
    "@melite/estate-call": "workspace:*",
    "@melite/estate-drafts": "workspace:*",
    "@melite/estate-media": "workspace:*",
    "@melite/estate-queue": "workspace:*",
    "@melite/image-image-edit": "workspace:*",
    "@melite/image-image-gen": "workspace:*",
    "@melite/models-h3": "workspace:*",
    "@melite/motion-motion": "workspace:*",
    "@melite/video-h3-timeline": "workspace:*",
    "sharp": "0.35.5"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml"
  ],
  "license": "AGPL-3.0-or-later",
  "description": "The estate's DSH tool surface as a bundle \u2014 the compose-first toolset, the /melite-runs delegation's run doors, and the editor's Enhance host routes.",
  "repository": {
    "type": "git",
    "url": "https://github.com/JayDataEngineer/melite.git",
    "directory": "packages/harness/melite-tools"
  },
  "keywords": [
    "melite",
    "comfyui",
    "cordis",
    "agent",
    "media-generation",
    "dsh-bundle"
  ]
}
