{
  "name": "@melite-plugin/dsh-tools",
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./lib/index.mjs"
  },
  "scripts": {
    "build": "tsdown src/index.ts --format esm --dts --outDir lib",
    "typecheck": "tsc --noEmit",
    "test:smoke": "node test/smoke.mjs"
  },
  "dsh": {
