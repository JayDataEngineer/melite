    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@deepseek-ai/dsh-llm": "0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": "0.1.1-rc.2",
    "@melite/audio-music": "workspace:*",
    "@melite/audio-tts": "workspace:*",
    "@melite/audio-voice-lock": "workspace:*",
    "@melite/image-image-edit": "workspace:*",
    "@melite/motion-motion": "workspace:*",
    "@melite/video-h3-timeline": "workspace:*",
    "unrun": "^0.3.1",
    "@melite/gateway-core": "workspace:*"
  }
