{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    // Node-only (the engine plane): no DOM lib — DOM's globals shadow
    // node's Buffer/Uint8Array shapes and poison every Buffer site in
    // the program (gate-found 2026-09-12). fetch/AbortController/
    // URLSearchParams all ride @types/node 22.
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts"]
}
