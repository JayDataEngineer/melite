{
  "name": "@melite/gateway-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The gateway BUNDLE (STAGE 1 of the DSH bundle split, dsh-base shape): composition + cordis.config.json manifest ownership; code lives in @melite/gateway-core, @melite/gateway-doors, @melite/queue, @melite/comfyui. Runtime is node --experimental-strip-types (erasable-syntax TS); no build step.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "workspace:*",
    "@deepseek-ai/cordis-plugin-include": "workspace:*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@deepseek-ai/cordis-plugin-logger-console": "workspace:*",
    "@deepseek-ai/cordis-plugin-timer": "workspace:*",
    "@deepseek-ai/dsh-api-gateway": "0.1.0-rc.8",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.8",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@deepseek-ai/dsh-settings-file": "0.1.5-alpha.2",
    "@deepseek-ai/dsh-typert-registry": "0.1.0-rc.8",
    "@melite/comfyui-cordis": "workspace:*",
    "@melite/gateway-core": "workspace:*",
    "@melite/gateway-doors": "workspace:*",
    "@melite/gateway-queue": "workspace:*",
    "@melite/gateway-wire": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
