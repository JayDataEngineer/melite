{
  "name": "@melite/gateway-doors",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The 15 gateway door plugins (STAGE 1 of the DSH bundle split): one Cordis plugin per serving section. Owns HTTP-door bodies only; shared contracts ride @melite/gateway-core, run state rides @melite/queue, inference rides @melite/comfyui.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./assets": "./src/entries/assets.ts",
    "./bridges": "./src/entries/bridges.ts",
    "./bench": "./src/entries/bench.ts",
    "./disclose": "./src/entries/disclose.ts",
    "./card-registry": "./src/entries/card-registry.ts",
    "./chrome": "./src/entries/chrome.ts",
    "./discovery": "./src/entries/discovery.ts",
    "./drafts": "./src/entries/drafts.ts",
    "./flows-start": "./src/entries/flows-start.ts",
    "./flows-status": "./src/entries/flows-status.ts",
    "./flows-stop": "./src/entries/flows-stop.ts",
    "./package.json": "./package.json",
    "./planes": "./src/entries/planes.ts",
    "./route-mount": "./src/routeMount.ts",
    "./runs": "./src/entries/runs.ts",
    "./runs-registry": "./src/entries/runs-registry.ts",
    "./studios": "./src/entries/studios.ts",
    "./uploads": "./src/entries/uploads.ts",
    "./validate": "./src/entries/validate.ts"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-host-webserver": "workspace:*",
    "@melite/comfyui-cordis": "workspace:*",
    "@melite/gateway-core": "workspace:*",
    "@melite/gateway-queue": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
