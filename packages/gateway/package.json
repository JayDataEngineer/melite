{
  "name": "@melite/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The gateway HTTP shell + queue (Phase-0: the ROUTES generated mirror only — .scratch/gateway-ts-map.md §5). First-class plugin under the packages/* workspace glob; engine-agnostic, shells multiple engines via @comfyui/cordis (Phase 1+). Runtime is node --experimental-strip-types (erasable-syntax TS); no build step.",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./routes": "./src/routes.ts",
    "./package.json": "./package.json"
  },
  "scripts": {
    "mirror": "python3 ../../tools/gen_routes_mirror.py",
    "mirror:check": "python3 ../../tools/gen_routes_mirror.py --check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/schemastery": "*",
    "@deepseek-ai/cordis-plugin-loader": "workspace:*",
    "@deepseek-ai/cordis-plugin-timer": "workspace:*",
    "@deepseek-ai/cordis-plugin-logger-console": "workspace:*",
    "@deepseek-ai/dsh-storage": "0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-json": "0.0.1-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.0.1-rc.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3"
  }
}
