{
  "version": "0.3.0-rc.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./card": {
      "types": "./lib/card.d.ts",
      "default": "./lib/card.js"
    },
    "./v2v-face": {
      "types": "./lib/ui/v2vFace.d.ts",
      "default": "./lib/ui/v2vFace.js"
    },
    "./package.json": "./package.json",
    "./tool": {
      "types": "./lib/tool.d.ts",
      "default": "./lib/tool.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "bundle": "tsdown",
    "typecheck": "tsc --noEmit -p tsconfig.host.json && tsc --noEmit -p tsconfig.client.json"
  },
  "dependencies": {
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.5",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.2-rc.5",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.5",
    "@melite-plugin/timeline": "workspace:~",
    "@melite/card-base": "workspace:*",
    "@melite/catalog": "workspace:*",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/estate-call": "workspace:*",
    "@melite/models-h3": "workspace:*",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.184.1",
    "tsdown": "^0.22.14",
    "typescript": "~6.0.3"
  },
  "name": "@melite/video-h3-timeline",
  "description": "The video lane's only door \u2014 the h3-timeline card, tool, and studio that tile H3 film windows and score them with dialogue, sfx, and music clips.",
  "dsh": {
    "client": {
      "platform": "web",
      "external": [
        "@melite/card-base/client"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "sideEffects": true,
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh": ">=0.2.2-rc.5 <0.3.0"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "lib/**/*.json",
    "lib/**/*.module.css",
    "cordis.patch.yml",
    "src/card.ts",
    "src/agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/JayDataEngineer/melite.git",
    "directory": "packages/video/h3-timeline"
  },
  "keywords": [
    "melite",
    "comfyui",
    "cordis",
    "agent",
    "media-generation",
    "dsh-bundle"
  ]
}
