{
  "name": "@melite/video-trim",
  "version": "0.3.0-rc.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "description": "the trim card (the video lane's preprocessing door) — clip in, timestamp-trimmed clip out (VHS load window + combine)",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./card": {
      "types": "./lib/card.d.ts",
      "default": "./lib/card.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/contracts": "workspace:*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@types/node": "^22.20.5",
    "typescript": "~6.0.3"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/card.ts",
    "src/agents"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JayDataEngineer/melite.git",
    "directory": "packages/video/trim"
  },
  "keywords": [
    "melite",
    "comfyui",
    "cordis",
    "agent",
    "media-generation",
    "library"
  ]
}
