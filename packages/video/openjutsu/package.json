{
  "name": "@melite/video-openjutsu",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "version": "0.1.5-pre-alpha",
  "type": "module",
  "description": "the openjutsu card (the video lane) — Openjutsu character/subject swap in video: one still sets identity, the driving clip sets motion; schema-form card over the viggle-animate family's animate action",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./card": {
      "types": "./lib/card.d.ts",
      "default": "./lib/card.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.5",
    "@melite/comfyui-card-kit": "workspace:*",
    "@melite/contracts": "workspace:*",
    "@melite/models-viggle-animate": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "typescript": "^5.9.3",
    "@deepseek-ai/cordis": "^4.0.5"
  },
  "files": [
    "lib/index.js",
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5"
  }
}
