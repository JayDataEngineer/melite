# ============================================================================
# ComfyUI executor image — docker WRAPS the self-bootstrap.
#
# The image carries only the engine runtime (python + comfy-cli + a ComfyUI
# workspace). The bootstrap itself (bootstrap.py + plugins/ declarations +
# infra/patches) is bind-mounted from the repo at /opt/inference-src, and the
# entrypoint runs the EXACT commands bare metal runs:
#
#     python3 bootstrap.py --extensions --models --comfyui-dir /root/ComfyUI
#     exec .venv/bin/python main.py --listen 0.0.0.0 --port 18465
#
# Extensions land pinned, models land sha256-verified into the models volume.
# First boot is slow (downloads); every later boot is idempotent and fast.
# ============================================================================

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV COMFYUI_DIR=/root/ComfyUI

RUN apt-get update && apt-get install -y \
    git curl ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir comfy-cli

# Workspace: stock ComfyUI core, pinned — core is NEVER patched on this
# machine (the H3 lane ships its nodes as custom-node packs).
RUN comfy install --version 0.34.0 /root/ComfyUI

# The bootstrap + declarations + patches arrive via the bind mount
# (compose: . -> /opt/inference-src:ro); nothing is baked into the image.
EXPOSE 18465

ENTRYPOINT ["bash", "/opt/inference-src/infra/comfyui/entrypoint.sh"]
