# ============================================================================
# ComfyUI executor image — docker WRAPS the self-bootstrap.
#
# The image carries only the engine runtime (python + comfy-cli + node + a
# ComfyUI workspace). The bootstrap itself (the provisioner + nodes.yaml
# declarations + infra/patches) is bind-mounted from the repo at
# /opt/inference-src, and the entrypoint runs the EXACT commands bare metal
# runs:
#
#     pnpm run provision -- all       (the typescript provisioner)
#     exec .venv/bin/python main.py --listen 0.0.0.0 --port 18465
#
# Extensions land pinned, models land sha256-verified into the models volume.
# First boot is slow (downloads); every later boot is idempotent and fast.
# ============================================================================

FROM python:3.12-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV COMFYUI_DIR=/root/ComfyUI

RUN apt-get update && apt-get install -y \
    git curl ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir comfy-cli

# Workspace: stock ComfyUI core, pinned — core is NEVER patched on this
# machine (the H3 lane ships its nodes as custom-node packs). Version
# tracks infra/comfyui/core.pin (the provisioner checks out the sha;
# comfy install lands the matching tag — audit 005/E1, 2026-10-22).
RUN comfy install --version 0.38.0 /root/ComfyUI

# The orchestrator + declarations + patches arrive via the bind mount
# (compose: . -> /opt/inference-src:ro); nothing is baked into the image.
EXPOSE 18465

ENTRYPOINT ["bash", "/opt/inference-src/infra/comfyui/entrypoint.sh"]
