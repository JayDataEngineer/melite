# inference.cpp ComfyUI image — adapted from ray's Tech Noir image (2026-08-26).
# The extension lane SSOT: plugins/comfyui/nodes/extensions.yaml
# (ONE PATTERN — every extension link lives there; no manifests, no
# mirrors). In-tree pack code is git-tracked at
# plugins/comfyui/custom_nodes/ and COPYd below — no staging step.
#
# One image, one GPU owner: a pinned upstream ComfyUI with the ComfyUI-Manager
# baked in, plus every custom-node pack the plugins declare in their lane
# (plugins/<id>/nodes/extensions.yaml — §16 E-EXTENSIONS). Nothing else is
# baked: no vendor model code, no sidecar services. The ComfyUI One Way rule —
# all inference runs here, and the plugin lane is the ONLY place extensions
# are declared.
#
# Base: yanwk/comfyui-boot:cu130-megapak-pt211 — torch 2.11.0+cu130, CUDA 13.0,
# Python 3.13, flash_attn 2.8.3, sageattention 2.2.0. (The cu128 variant was
# the pre-cutover base; the 2026-08-05 cutover measured cu130 + EasyCache as
# faster on H3 — keep cu130 as the only base.)
#
# The base bundles a ComfyUI snapshot that may lag the model support the
# catalog expects, so Phase 0 pins ComfyUI to the tracked commit (the same
# pin the host dev clone uses — keep the two in sync):
#
#   e01fb4c (2026-08-13) = 2f35f4a (v0.33.0, the io-schema release) + 03fa4e4
#   (minimax music fix on non-dynamic VRAM) + #15439: MiniMaxH3AddGuide —
#   anchors a still image, a clip, or audio at ANY frame_idx (negative counts
#   from the end), chained through the positive conditioning — plus 5cfe0cd
#   (anchors to the target timeline when references are present; without it
#   every reference silently slides guides earlier). Carries the
#   MiniMaxMusic3TextEncode + EmptyMiniMaxMusic3LatentAudio nodes (the
#   music3 family) and deletes H3LatentNoiseInjector / MiniMaxH3TextOnly /
#   MiniMaxH3AddKeyframe — the melite-h3-nodes pack is retired and the builders
#   FAIL LOUD if a saved pipeline requests those features. The io-schema
#   release also keys /prompt nodes by ComfyScript-style `ClassName.N` ids —
#   the server-js graph DSL emits exactly that, so the pin is load-bearing.
#
# Build (repo root as context):
#   docker build -f infra/comfyui/Dockerfile.comfyui \
#     -t forge-reg.local:30500/tech-noir/comfyui:cu130 .
#   → `docker compose up -d inference-comfyui` serves it at :18465.
#
# To add an extension: edit plugins/comfyui/nodes/extensions.yaml
# (name/url/ref/pip/patches). This file never changes for new content.
#
# Host dev without Docker: infra/comfyui/bootstrap.sh --core --lane
# provisions /opt/ComfyUI at the HOST pin (2f35f4a + seam patches — see
# patches/comfyui-core/PIN.md; note this image's pin below is a
# different, upstream-only feature set).

FROM yanwk/comfyui-boot:cu130-megapak-pt211

# ── Phase 0: pin ComfyUI core to the tracked version ─────────────────────
# The base's bundled snapshot may lag the model support the catalog needs.
# Fresh-clone the pinned commit (not a COPY — `git clone && docker build`
# works with zero manual submodule steps; GitHub fetch-by-SHA keeps the
# fetch to a single commit).
#
# NO --upgrade below: `pip install -r requirements.txt` without --upgrade
# still upgrades version-pinned packages (comfy-kitchen/aimdo must match the
# commit — API changes like get_file_handle are breaking) but will NOT
# upgrade unpinned packages like `torch` (the base ships the CUDA wheel;
# --upgrade would pull a different CUDA build and break the megapak).
ARG COMFYUI_COMMIT=e01fb4c56b7a88149d469b99cbbfe3223d715054
RUN rm -rf /root/ComfyUI && \
    mkdir -p /root/ComfyUI && \
    cd /root/ComfyUI && \
    git init && \
    git remote add origin https://github.com/comfyanonymous/ComfyUI.git && \
    git fetch --depth 1 origin ${COMFYUI_COMMIT} && \
    git checkout FETCH_HEAD && \
    rm -rf .git
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir -r /root/ComfyUI/requirements.txt
# comfy-angle provides the EGL/ANGLE bindings comfy_extras/nodes_glsl.py
# imports (comfy_angle.get_egl_path). Without it ComfyUI logs a warning on
# every startup and the GLSL nodes are unavailable.
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --no-cache-dir comfy-angle
# sageattention 2.2.0 ABORTS the whole process on torch 2.11 (CUDA
# "unspecified launch failure" inside sageattn — 2026-08-24, killed every
# image/video sampling until disabled at runtime). Model loaders pick it
# up whenever it is importable, so its presence is a landmine: remove it.
# Attention falls back to sdpa / --use-pytorch-cross-attention everywhere.
RUN pip uninstall --no-cache-dir -y sageattention || true

# ── Phase 0.5: repo-owned runtime libs the packs import ─────────────────
# melite_model_base (the shared ComfyUI-tracked pipeline wrapper) is VENDORED
# inside each consuming pack at <pack>/_vendor/melite_model_base/ — canonical
# source packages/melite-model-base/, kept byte-identical by
# scripts/sync_melite_model_base.py (--check runs in CI). Nothing to bake.
# /opt serves host-mounted vendor sources (see docker-compose.yml:
# kimodo → /opt/kimodo, anigen → /opt/anigen/anigen). /opt/anigen is on
# the path because the anigen pack has no bootstrap of its own — the
# retired full image carried these exact dirs on PYTHONPATH.
ENV PYTHONPATH=/opt:/opt/anigen

# Public source trees two packs probe at their env-or-/opt defaults
# (SEETHROUGH_SRC / HYMOTION_SRC). Libraries, not custom nodes — they stay
# OUT of custom_nodes/ so the lane purge never sees them. Unpinned
# --depth 1 (same as the retired image); pin if drift ever bites.
RUN git clone --depth 1 https://github.com/shitagaki-lab/see-through.git /opt/seethrough && \
    git clone --depth 1 https://github.com/Tencent-Hunyuan/HY-Motion-1.0.git /opt/hymotion

# ── Phase 1: the plugin custom-node lane (SSOT: plugins/*/nodes/extensions.yaml) ─
# setup_comfyui.py (with extension_lane.py) merges every plugin's declared
# extensions in deterministic plugin-id order: it PURGES everything the base
# image ships that is not declared (the megapak bundles ~30 community
# extensions we don't want — they leak phantom nodes that break the
# schema-driven builder and the ComfyUI-Manager mapping), git-clones each
# declared extension at its pinned ref, installs the lane-declared pip deps
# (the ONLY dependency channel — a plugin's `pip:` list is the declaration),
# applies the melite-fork patches
# (infra/docker/patches/<name>/apply.sh), and copies the in-tree packs.
# ComfyUI-Manager is lane-declared by melite-core (required) — that is the
# "baked-in manager" of this image.
COPY plugins/ /tmp/melite-plugins/
COPY infra/comfyui/stage/extra_model_paths.yaml /tmp/extra_model_paths.yaml
COPY infra/comfyui/patches/ /tmp/patches/
COPY infra/comfyui/extension_lane.py /tmp/extension_lane.py
COPY infra/comfyui/setup_comfyui.py /tmp/setup_comfyui.py
# In-tree node packs (no git URL — declared url-less in the lane;
# code is git-tracked at plugins/comfyui/custom_nodes/<name>)
COPY plugins/comfyui/custom_nodes/melite-anigen-nodes /tmp/in-tree-packs/melite-anigen-nodes
COPY plugins/comfyui/custom_nodes/melite-autorig-nodes /tmp/in-tree-packs/melite-autorig-nodes
COPY plugins/comfyui/custom_nodes/melite-seethrough-nodes /tmp/in-tree-packs/melite-seethrough-nodes
COPY plugins/comfyui/custom_nodes/melite-step1x-nodes /tmp/in-tree-packs/melite-step1x-nodes
COPY plugins/comfyui/custom_nodes/melite-stretchy-nodes /tmp/in-tree-packs/melite-stretchy-nodes
RUN python3 /tmp/setup_comfyui.py && rm -rf /tmp/setup_comfyui.py /tmp/extension_lane.py /tmp/melite-plugins /tmp/in-tree-packs

# The base image's entrypoint handles auto-start + supervisor; the port is
# overridable at runtime (the compose sets --port 18465 via CLI_ARGS).
EXPOSE 18465
