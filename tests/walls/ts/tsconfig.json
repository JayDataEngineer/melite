{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    // pnpm does not hoist @types/node to the repo root, and the wall
    // plane owns no package.json (no new deps) — borrow the pnpm
    // store's copy directly (the gateway-doors leaf borrow died with
    // a store reshuffle; the store path is the stable floor).
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "typeRoots": ["../../../node_modules/.pnpm/@types+node@24.13.3/node_modules/@types"],
    // L12's second find (li-aq.3): pnpm strictness means the wall
    // plane has NO bare-specifier links of its own — every suite
    // import resolved only at vitest time. The drafts leaf carries
    // the full cordis + dsh-storage set (and IS estate-drafts), so
    // paths borrow its copies; a suite naming a NEW bare dependency
    // fails HERE, loudly, instead of resolving by magic. Each row
    // below mirrors vitest.shared.ts's resolutionFacade (the alias
    // table vitest resolves at runtime): the timer rides the
    // estate-queue-anchored copy, the Typert protocol the
    // drafts-anchored copy, the workspace remotes + gallery their
    // src planes. TYPECHECK-ONLY (noEmit; vitest never reads
    // tsconfig paths — it spreads the facade), so extending this
    // table changes no runtime.
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../../../packages/estate/drafts/node_modules/@deepseek-ai/cordis"],
      "@deepseek-ai/cordis-plugin-timer": ["../../../packages/harness/estate-queue/node_modules/@deepseek-ai/cordis-plugin-timer"],
      "@deepseek-ai/dsh-storage": ["../../../packages/estate/drafts/node_modules/@deepseek-ai/dsh-storage"],
      "@deepseek-ai/dsh-storage-domain": ["../../../packages/estate/drafts/node_modules/@deepseek-ai/dsh-storage-domain"],
      "@deepseek-ai/dsh-storage-json": ["../../../packages/estate/drafts/node_modules/@deepseek-ai/dsh-storage-json"],
      "@deepseek-ai/dsh-typert-protocol": ["../../../packages/estate/drafts/node_modules/@deepseek-ai/dsh-typert-protocol"],
      "@melite/estate-drafts": ["../../../packages/estate/drafts/src/index.ts"],
      "@melite/estate-manage": ["../../../packages/estate/manage/src/index.ts"],
      "@melite/estate-runs": ["../../../packages/estate/runs/src/index.ts"],
      "@infer-media/dsh-gallery": ["../../../packages/web/infer-gallery/src/index.ts"]
    }
  },
  // L12 (li-aq.3): the include named *.test.ts while every suite
  // here is *.spec.ts — the walls' own plane typechecked NOTHING (a
  // wall suite that names a pattern with no members is a wall that
  // never judged itself).
  "include": ["helpers/**/*.ts", "suites/**/*.spec.ts"]
}
