{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "lib": ["ES2022"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"],
    // @types/node is a root devDependency (F-5 cure, 2026-11-05): the
    // default typeRoots walk reaches the repo root's node_modules/@types,
    // so the face carries no pnpm-store path.
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    // L12's second find (li-aq.3): pnpm strictness means the wall
    // plane has NO bare-specifier links of its own — every suite
    // import resolved only at vitest time. The drafts leaf carries
    // the full cordis + dsh-storage set (and IS estate-drafts), so
    // paths borrow its copies; a suite naming a NEW bare dependency
    // fails HERE, loudly, instead of resolving by magic. Each row
    // below mirrors vitest.shared.ts's resolutionFacade (the alias
    // table vitest resolves at runtime): the timer rides the
    // estate-queue-anchored copy, the Typert protocol the
    // drafts-anchored copy, the workspace remotes their
    // src planes. TYPECHECK-ONLY (noEmit; vitest never reads
    // tsconfig paths — it spreads the facade), so extending this
    // table changes no runtime.
    "baseUrl": ".",
    "paths": {
      "@deepseek-ai/cordis": ["../../../packages/estate/drafts/node_modules/@deepseek-ai/cordis"],
      "@deepseek-ai/cordis-plugin-timer": ["../../../packages/harness/estate-queue/node_modules/@deepseek-ai/cordis-plugin-timer"],
      "@deepseek-ai/dsh-storage": ["../../../packages/estate/drafts/node_modules/@deepseek-ai/dsh-storage"],
      "@deepseek-ai/dsh-storage-domain": ["../../../packages/estate/drafts/node_modules/@deepseek-ai/dsh-storage-domain"],
      "@deepseek-ai/dsh-storage-json": ["../../../packages/estate/drafts/node_modules/@deepseek-ai/dsh-storage-json"],
      "@deepseek-ai/dsh-typert-protocol": ["../../../packages/estate/drafts/node_modules/@deepseek-ai/dsh-typert-protocol"],
      "@melite/comfyui-card-kit": ["../../../packages/engines/comfyui-card-kit/src/kit.ts"],
      "@melite/comfyui-card-kit/admission": ["../../../packages/engines/comfyui-card-kit/src/admission.ts"],
      "@melite/comfyui-card-kit/card-definition": ["../../../packages/engines/comfyui-card-kit/src/card-definition.ts"],
      "@melite/comfyui-card-kit/errors": ["../../../packages/engines/comfyui-card-kit/src/errors.ts"],
      "@melite/comfyui-card-kit/facts": ["../../../packages/engines/comfyui-card-kit/src/facts.ts"],
      "@melite/comfyui-card-kit/fields": ["../../../packages/engines/comfyui-card-kit/src/fields.ts"],
      "@melite/comfyui-card-kit/graph": ["../../../packages/engines/comfyui-card-kit/src/graph.ts"],
      "@melite/comfyui-card-kit/guard": ["../../../packages/engines/comfyui-card-kit/src/mods/guard.ts"],
      "@melite/comfyui-card-kit/impact": ["../../../packages/engines/comfyui-card-kit/src/impact.ts"],
      "@melite/comfyui-card-kit/linked": ["../../../packages/engines/comfyui-card-kit/src/linked.ts"],
      "@melite/comfyui-card-kit/model-contract": ["../../../packages/engines/comfyui-card-kit/src/model-contract.ts"],
      "@melite/comfyui-card-kit/morphs": ["../../../packages/engines/comfyui-card-kit/src/morphs.ts"],
      "@melite/comfyui-card-kit/pack-fields": ["../../../packages/engines/comfyui-card-kit/src/pack-fields.ts"],
      "@melite/comfyui-card-kit/paramRows": ["../../../packages/engines/comfyui-card-kit/src/paramRows.ts"],
      "@melite/comfyui-card-kit/params-emit": ["../../../packages/engines/comfyui-card-kit/src/params-emit.ts"],
      "@melite/comfyui-card-kit/semanticModelKnob": ["../../../packages/engines/comfyui-card-kit/src/semanticModelKnob.ts"],
      "@melite/comfyui-card-kit/service-faces": ["../../../packages/engines/comfyui-card-kit/src/service-faces.ts"],
      "@melite/comfyui-card-kit/tts-segments": ["../../../packages/engines/comfyui-card-kit/src/tts-segments.ts"],
      "@melite/comfyui-card-kit/vocab": ["../../../packages/engines/comfyui-card-kit/src/vocab.ts"],
      "@melite/comfyui-cordis": ["../../../packages/engines/comfyui-cordis/src/index.ts"],
      "@melite/comfyui-cordis/catalog-registry": ["../../../packages/engines/comfyui-cordis/src/entries/catalog-registry.ts"],
      "@melite/comfyui-cordis/cli": ["../../../packages/engines/comfyui-cordis/src/cli.ts"],
      "@melite/comfyui-cordis/comfyui-engine": ["../../../packages/engines/comfyui-cordis/src/entries/comfyui-engine.ts"],
      "@melite/comfyui-cordis/comfyui-host": ["../../../packages/engines/comfyui-cordis/src/entries/comfyui-host.ts"],
      "@melite/comfyui-cordis/comfyui-wiring": ["../../../packages/engines/comfyui-cordis/src/entries/comfyui-wiring.ts"],
      "@melite/comfyui-cordis/envelope-laws": ["../../../packages/engines/comfyui-cordis/src/envelope-laws.ts"],
      "@melite/comfyui-cordis/models-service": ["../../../packages/engines/comfyui-cordis/src/models/service.ts"],
      "@melite/comfyui-cordis/service": ["../../../packages/engines/comfyui-cordis/src/service.ts"],
      "@melite/comfyui-cordis/user-loras": ["../../../packages/engines/comfyui-cordis/src/userLoras.ts"],
      "@melite/contracts/benchResult": ["../../../packages/web-kit/contracts/src/benchResult.ts"],
      "@melite/contracts/laneRelations": ["../../../packages/web-kit/contracts/src/laneRelations.ts"],
      "@melite/contracts/mediaKinds": ["../../../packages/web-kit/contracts/src/mediaKinds.ts"],
      "@melite/contracts/rootsManifest": ["../../../packages/web-kit/contracts/src/rootsManifest.ts"],
      "@melite/engine-contract": ["../../../packages/engines/contract/src/index.ts"],
      "@melite/estate-drafts": ["../../../packages/estate/drafts/src/index.ts"],
      "@melite/estate-manage": ["../../../packages/estate/manage/src/index.ts"],
      "@melite/estate-provisioning": ["../../../packages/estate/provisioning/src/index.ts"],
      "@melite/estate-runs": ["../../../packages/estate/runs/src/index.ts"]
    }
  },
  // L12 (li-aq.3): the include named *.test.ts while every suite
  // here is *.spec.ts — the walls' own plane typechecked NOTHING (a
  // wall suite that names a pattern with no members is a wall that
  // never judged itself).
  "include": ["helpers/**/*.ts", "suites/**/*.spec.ts"]
}
