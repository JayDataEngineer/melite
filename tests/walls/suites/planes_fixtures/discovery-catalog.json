    "stage_shape": {
      "fields": [
        "card",
        "card_io",
        "description",
        "engine",
        "expected",
        "id",
        "inputs",
        "outputs",
        "params",
        "retries",
        "skip_when",
        "timeout_s"
      ],
      "id": "stage id (unique; edges reference it)",
      "engine": "one of engines above (validated at compile)",
      "card": "optional action-card id — opts the stage into the typed card gate (params validated against the card schema)",
      "params": "the engine's verbatim surface (workflow / out_dir / timeout_s for comfyui; task/family for audio_cpp) — unvalidated here unless card= is set",
      "inputs": "name -> {\"initial\": key} (a request key) or {\"stage\": id, \"output\": name} (an earlier stage's output; kind is INFERRED upstream)",
      "outputs": "name -> Kind string (omit for the engine default)",
      "expected": "name -> Kind string (what each input expects; required unless card= fills it)",
      "skip_when": "{\"initial\": key, \"when\": \"present|absent\"} — prunes the stage at build time",
      "edge_rules": "edges must point at EARLIER stages; a kind mismatch refuses at compile with both kinds named"
    },
    "flow_body": {
      "keys": [
        "description",
        "id",
        "stages"
      ],
      "example": {
        "id": "my-flow",
        "stages": [
          {
            "id": "gen",
            "engine": "anycreature",
            "inputs": {
              "prompt": {
                "initial": "prompt"
              }
            },
            "expected": {
              "prompt": "text"
            }
          },
          {
            "id": "remesh",
            "engine": "comfyui",
            "inputs": {
              "mesh": {
                "stage": "gen",
                "output": "default"
              }
            },
            "expected": {
              "mesh": "mesh"
            }
          }
        ]
      }
    },
    "doors": {
      "start": "POST /v1/flows/start with exactly one of {\"flow\": name} | {\"flow_inline\": {...}} | {\"model\": id}, PLUS a REQUIRED doc-backed \"draft_id\" on the envelope (CARD BIRTH LAW: compose at POST /v1/flows/drafts first — a cardless start 4xxes BEFORE any run registers)",
      "validate": "POST /v1/flows/validate with {\"flow_inline\": {...}} — verbatim compile refusals, no queue slot, no GPU, no sidecar",
      "status": "GET /v1/flows/status/<run_id> — stages, progress, queue_position",
      "stop": "POST /v1/flows/stop/<run_id>"
    },
