{
  "tools": [
    {
      "name": "h3_timeline_card",
      "version": 1,
      "kind": "card-compose",
      "card": "h3-timeline",
      "model": "h3-timeline",
      "stage_title": "H3 Timeline",
      "description": "THE video interface — multi-window film with SLA sparse attention, joint video+audio per window, auto-stitched into one mp4. The calls document IS the timeline.",
      "params_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Verb-first motion + the sounds. For keyframes the image already sets the scene — prompt what CHANGES."
          },
          "image": {
            "type": "string",
            "description": "Absolute path to the PNG the video must start on (h3-keyframe). Optional for h3/h3-timeline."
          },
          "ref_image": {
            "type": "string",
            "description": "Absolute path to a reference image for identity-locked generation. The hybrid model auto-routes to Ref2VA mode when connected. Optional — leave empty for standard FL2VA text-to-video."
          },
          "seed": {
            "type": "integer",
            "default": 42,
            "description": "Same seed across re-rolls = same world texture"
          },
          "width": {
            "type": "integer",
            "minimum": 448,
            "maximum": 1344,
            "default": 768,
            "description": "Width"
          },
          "height": {
            "type": "integer",
            "minimum": 448,
            "maximum": 768,
            "default": 448,
            "description": "Height"
          },
          "length": {
            "type": "integer",
            "minimum": 21,
            "maximum": 362,
            "default": 56,
            "description": "17k+5 grid at 24fps: 56 = 2.33s, 124 = 5.17s, 362 = 15s"
          },
          "steps": {
            "type": "integer",
            "minimum": 4,
            "maximum": 30,
            "default": 12,
            "description": "12 for draft; 30 standard; 10 with the turbo LoRA"
          },
          "sharpen_enabled": {
            "type": "boolean",
            "default": "true",
            "description": "Apply AMD FidelityFX RCAS sharpening to the final output. Strength 0.3 looks natural."
          },
          "sharpen_strength": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.3,
            "description": "RCAS sharpening intensity. 0.3 = natural; 0.5 = crisp; 0.0 = off."
          },
          "interpolate_enabled": {
            "type": "boolean",
            "default": "false",
            "description": "Apply FILM (Feature-aware Interpolation for Large Motion) frame interpolation to double the frame rate. Doubles render time."
          },
          "shift_video": {
            "type": "number",
            "minimum": 1,
            "maximum": 20,
            "default": 12.0,
            "description": "Timestep shift for video attention. Higher = more coherent motion."
          },
          "shift_audio": {
            "type": "number",
            "minimum": 1,
            "maximum": 10,
            "default": 3.0,
            "description": "Timestep shift for audio attention. Lower = more detailed sound."
          }
        },
        "required": [
          "prompt"
        ]
      }
    },
    {
      "name": "image_edit_card",
      "version": 1,
      "kind": "card-compose",
      "card": "image-edit",
      "model": "img-edit",
      "stage_title": "Image Edit",
      "description": "Instruction-driven image editing — the edit_image family card (build_img2img_edit); up to three input images + reference list, mask-aware region editing, LanPaint tuning",
      "params_schema": {
        "type": "object",
        "properties": {
          "input_image": {
            "type": "string",
            "format": "path",
            "description": "Image"
          },
          "mask": {
            "type": "string",
            "format": "path",
            "description": "Optional region mask — omit to edit the whole image."
          },
          "image2": {
            "type": "string",
            "format": "path",
            "description": "Image 2"
          },
          "image3": {
            "type": "string",
            "format": "path",
            "description": "Image 3"
          },
          "reference_images": {
            "type": "array",
            "description": "Multi-image picker (up to 3). Used by workflows that pass resolved image lists; complements the individual Image 2 / Image 3 slots above."
          },
          "prompt": {
            "type": "string",
            "description": "Prompt"
          },
          "negative_prompt": {
            "type": "string",
            "x-visible-when": "negative_prompt != null",
            "description": "Negative Prompt"
          },
          "width": {
            "type": "number",
            "minimum": 256,
            "maximum": 2048,
            "description": "Width"
          },
          "height": {
            "type": "number",
            "minimum": 256,
            "maximum": 2048,
            "description": "Height"
          },
          "seed": {
            "type": "integer",
            "default": -1,
            "description": "Seed"
          },
          "steps": {
            "type": "number",
            "minimum": 1,
            "maximum": 50,
            "description": "Steps"
          },
          "cfg": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10,
            "description": "Qwen-Image-Edit uses low CFG (flow-matching)."
          },
          "sampler": {
            "type": "string",
            "description": "Sampler — options resolve from the $samplers vocabulary at serve time"
          },
          "scheduler": {
            "type": "string",
            "description": "Scheduler — options resolve from the $schedulers vocabulary at serve time"
          },
          "loras": {
            "type": "array",
            "description": "LoRAs"
          },
          "controlnet_strength_floor": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Minimum strength any ControlNet in the stack may apply at. Entries below are clamped UP. 0.0 = no floor. Raise when stacking weak CNs that cost VRAM without visual benefit."
          },
          "lanpaint_mask": {
            "type": "string",
            "format": "path",
            "x-visible-when": "input_image != null",
            "description": "RGBA PNG whose alpha channel marks the region to edit. When present alongside input_image, build_img2img_edit patches the model with the DiffSynth inpaint ControlNet."
          },
          "lanpaint_enabled": {
            "type": "boolean",
            "x-visible-when": "input_image != null",
            "description": "Force LanPaint"
          },
          "lanpaint_num_steps": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Num Steps"
          },
          "lanpaint_step_size": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 2,
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Step Size"
          },
          "lanpaint_lambda": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Lambda"
          },
          "lanpaint_beta": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Beta"
          },
          "lanpaint_friction": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Friction"
          },
          "lanpaint_prompt_mode": {
            "type": "string",
            "enum": [
              "negative",
              "positive"
            ],
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Prompt Mode"
          },
          "edit_mask_mode": {
            "type": "string",
            "enum": [
              "auto",
              "crop_stitch",
              "full_frame"
            ],
            "x-visible-when": "input_image != null",
            "description": "How the region mask is honored: auto (DiffSynth ControlNet if its weights are present, else crop+stitch), crop_stitch (crop to the mask + context, edit the crop, composite back — pixels outside the mask never change), full_frame (legacy whole-image edit; unmasked regions may drift)."
          },
          "edit_context_pad": {
            "type": "number",
            "minimum": 0,
            "maximum": 256,
            "x-visible-when": "input_image != null",
            "description": "Pixels of surrounding context kept in the crop (crop_stitch mode). More context = more coherent edit; 64 is the sweet spot."
          },
          "mask_grow": {
            "type": "number",
            "minimum": -32,
            "maximum": 32,
            "x-visible-when": "input_image != null",
            "description": "Expand (+) or shrink (−) the edit region by an exact pixel disk before the edit. Applied host-side — the same mask-prep chain the Inpaint card uses."
          },
          "mask_feather": {
            "type": "number",
            "minimum": 0,
            "maximum": 32,
            "x-visible-when": "input_image != null",
            "description": "Gaussian falloff the composite blends through — kills the pasted-on rectangle edge."
          },
          "mask_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "x-visible-when": "input_image != null",
            "description": "Re-binarize the feathered mask at this level. 0 = keep the soft falloff."
          },
          "mask_invert": {
            "type": "boolean",
            "x-visible-when": "input_image != null",
            "description": "Edit OUTSIDE the painted region instead."
          }
        },
        "required": [
          "input_image",
          "prompt"
        ]
      }
    },
    {
      "name": "image_gen_card",
      "version": 1,
      "kind": "card-compose",
      "card": "image-gen",
      "model": "krea-2",
      "stage_title": "Image",
      "description": "Text-to-image generation — the generate_image interface card boarding krea-2, anima and z-image; each family declares its own mods (loras on krea-2, lanpaint on anima/z-image) and the surface scopes itself",
      "params_schema": {
        "type": "object",
        "properties": {
          "model": {
            "type": "string",
            "enum": [
              "krea-2",
              "anima",
              "z-image"
            ],
            "description": "The boarded family to run — the request's top-level `model`. Options: krea-2, anima, z-image.",
            "default": "krea-2"
          },
          "preset": {
            "type": "string",
            "enum": [],
            "description": "Recipe shortcut — the LanPaint quick reference (tuning defaults). Fills untouched fields; values you've set win.",
            "x-families": [
              "z-image"
            ]
          },
          "prompt": {
            "type": "string",
            "description": "Prompt"
          },
          "negative_prompt": {
            "type": "string",
            "x-visible-when": "negative_prompt != null",
            "description": "Negative Prompt"
          },
          "width": {
            "type": "number",
            "minimum": 256,
            "maximum": 2048,
            "description": "Width"
          },
          "height": {
            "type": "number",
            "minimum": 256,
            "maximum": 2048,
            "description": "Height"
          },
          "seed": {
            "type": "integer",
            "default": -1,
            "description": "Seed"
          },
          "steps": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "description": "Steps"
          },
          "cfg": {
            "type": "number",
            "minimum": 1,
            "maximum": 20,
            "description": "How closely the diffusion follows the prompt. Higher = stricter."
          },
          "sampler": {
            "type": "string",
            "description": "Sampler — options resolve from the $samplers vocabulary at serve time"
          },
          "scheduler": {
            "type": "string",
            "description": "Scheduler — options resolve from the $schedulers vocabulary at serve time"
          },
          "loras": {
            "type": "array",
            "description": "LoRAs",
            "x-families": [
              "krea-2"
            ]
          },
          "input_image": {
            "type": "string",
            "format": "path",
            "description": "Image",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "lanpaint_mask": {
            "type": "string",
            "format": "path",
            "x-visible-when": "input_image != null",
            "description": "RGBA PNG whose alpha channel marks the region to regenerate. When present alongside input_image, build_txt2img switches to LanPaintKSampler.",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "lanpaint_enabled": {
            "type": "boolean",
            "default": false,
            "x-visible-when": "input_image != null",
            "description": "Force LanPaint",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "lanpaint_num_steps": {
            "type": "number",
            "minimum": 1,
            "maximum": 100,
            "default": 20,
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Num Steps",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "lanpaint_step_size": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 2,
            "default": 1.0,
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Step Size",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "lanpaint_lambda": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "default": 0.5,
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Lambda",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "lanpaint_beta": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "default": 0.5,
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Beta",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "lanpaint_friction": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "default": 0.5,
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Friction",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "lanpaint_prompt_mode": {
            "type": "string",
            "enum": [
              "negative",
              "positive"
            ],
            "default": "negative",
            "x-visible-when": "lanpaint_enabled == true",
            "description": "Prompt Mode",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "mask_grow": {
            "type": "number",
            "minimum": -32,
            "maximum": 32,
            "default": 8,
            "x-visible-when": "input_image != null",
            "description": "Grow / Shrink",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "mask_feather": {
            "type": "number",
            "minimum": 0,
            "maximum": 32,
            "default": 8,
            "x-visible-when": "input_image != null",
            "description": "Feather",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "mask_threshold": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0,
            "x-visible-when": "input_image != null",
            "description": "Re-threshold",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "mask_invert": {
            "type": "boolean",
            "default": false,
            "x-visible-when": "input_image != null",
            "description": "Invert",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "outpaint_top": {
            "type": "number",
            "minimum": 0,
            "maximum": 512,
            "default": 0,
            "x-visible-when": "input_image != null",
            "description": "Expand Top",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "outpaint_right": {
            "type": "number",
            "minimum": 0,
            "maximum": 512,
            "default": 0,
            "x-visible-when": "input_image != null",
            "description": "Expand Right",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "outpaint_bottom": {
            "type": "number",
            "minimum": 0,
            "maximum": 512,
            "default": 0,
            "x-visible-when": "input_image != null",
            "description": "Expand Bottom",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "outpaint_left": {
            "type": "number",
            "minimum": 0,
            "maximum": 512,
            "default": 0,
            "x-visible-when": "input_image != null",
            "description": "Expand Left",
            "x-families": [
              "anima",
              "z-image"
            ]
          },
          "outpaint_overlap": {
            "type": "number",
            "minimum": 0,
            "maximum": 64,
            "default": 16,
            "x-visible-when": "input_image != null",
            "description": "Overlap",
            "x-families": [
              "anima",
              "z-image"
            ]
          }
        },
        "required": [
          "prompt"
        ]
      }
    },
    {
      "name": "music_card",
      "version": 1,
      "kind": "card-compose",
      "card": "music",
      "model": "music3",
      "stage_title": "Music",
      "description": "Generate music — MiniMax Music 3, structured captions (Genre + Vocal Details + Arrangement) with tagged lyrics",
      "params_schema": {
        "type": "object",
        "properties": {
          "prompt": {
            "type": "string",
            "description": "Structured caption: Genre + Vocal Details + Arrangement. E.g. 'funk, pop, soul, guitar, 105 BPM'."
          },
          "lyrics": {
            "type": "string",
            "description": "Lyrics with structure tags: [verse], [chorus], [bridge]. Empty = instrumental."
          },
          "duration": {
            "type": "number",
            "minimum": 5,
            "maximum": 360,
            "description": "Target audio length in seconds (5-360)."
          },
          "guidance_scale": {
            "type": "number",
            "minimum": 0.1,
            "maximum": 10,
            "description": "Classifier-free guidance. IGNORED on Turbo (distilled weights — engine applies none); Base/SFT: 3.0-10.0, 7.0 recommended."
          },
          "n_diffusion_steps": {
            "type": "number",
            "minimum": 1,
            "maximum": 200,
            "description": "Flow-matching denoising steps. 8 = Turbo default (engine clamps Turbo to 8); Base recommended 32-50. Never 0."
          },
          "lm_cfg_scale": {
            "type": "number",
            "minimum": 0,
            "maximum": 10,
            "description": "LM CFG"
          },
          "negative_prompt": {
            "type": "string",
            "description": "Excludes unwanted musical traits (e.g. 'muddy bass, clipping, harsh vocals')."
          },
          "language": {
            "type": "string",
            "enum": [
              "en",
              "zh",
              "ja",
              "ko",
              "es",
              "fr",
              "de",
              "it",
              "ru",
              "pt"
            ],
            "description": "Vocal language for lyric/phoneme alignment. Default 'en' = English."
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "description": "LM planner temperature (song structure/lyrics). 0.7 default; 0.3-0.5 = predictable structures."
          },
          "top_p": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "LM planner nucleus sampling."
          },
          "seed": {
            "type": "integer",
            "default": -1,
            "description": "Seed"
          }
        },
        "required": [
          "prompt"
        ]
      }
    },
    {
      "name": "sfx_card",
      "version": 1,
      "kind": "card-compose",
      "card": "sfx",
      "model": "moss-sfx",
      "stage_title": "Sound Effects",
      "description": "Generate sound effects — MOSS-SFX v2, describe the SOUND not the scene",
      "params_schema": {
        "type": "object",
        "properties": {},
        "required": []
      }
    },
    {
      "name": "tts_card",
      "version": 1,
      "kind": "card-compose",
      "card": "tts",
      "model": "qwen3-tts",
      "stage_title": "TTS",
      "description": "Text-to-speech — Qwen3-TTS with CustomVoice personas and instruct-text emotion control",
      "params_schema": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "description": "The text to synthesize"
          },
          "voice": {
            "type": "string",
            "enum": [
              "ryan",
              "serena",
              "vivian",
              "aiden",
              "eric",
              "dylan",
              "sohee",
              "ono_anna",
              "uncle_fu"
            ],
            "default": "ryan",
            "description": "Preset speaker persona (CustomVoice) or .qvoice embedding path"
          },
          "style_instruction": {
            "type": "string",
            "description": "Emotion and delivery control (e.g. 'speak with warm confidence')"
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "default": 0.7,
            "description": "Temperature"
          },
          "seed": {
            "type": "integer",
            "default": -1,
            "description": "Seed"
          }
        },
        "required": [
          "text"
        ]
      }
    },
    {
      "name": "voice_lock_card",
      "version": 1,
      "kind": "card-compose",
      "card": "voice-lock",
      "model": "qwen3_tts_voicedesign",
      "stage_title": "Voice Lock",
      "description": "Lock a voice persona — design, export, and reuse .qvoice embeddings for consistent character voices",
      "params_schema": {
        "type": "object",
        "properties": {
          "voice_name": {
            "type": "string",
            "description": "Name for the locked persona — becomes the .qvoice filename stem. Reused across every future TTS render."
          },
          "style_instruction": {
            "type": "string",
            "description": "The voice description — becomes the VoiceDesign prompt (e.g. 'A warm female voice with a British accent')."
          },
          "reference_audio": {
            "type": "string",
            "format": "path",
            "description": "Optional reference clip to anchor the design."
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2,
            "default": 0.7,
            "description": "Temperature"
          },
          "top_p": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "default": 0.9,
            "description": "Top-P"
          },
          "speed": {
            "type": "number",
            "minimum": 0.5,
            "maximum": 2,
            "default": 1.0,
            "description": "Speed"
          },
          "repetition_penalty": {
            "type": "number",
            "minimum": 0.8,
            "maximum": 2,
            "default": 1.05,
            "description": "Repetition Penalty"
          },
          "seed": {
            "type": "integer",
            "default": -1,
            "description": "Seed"
          }
        },
        "required": [
          "voice_name",
          "style_instruction"
        ]
      }
    }
  ]
}
