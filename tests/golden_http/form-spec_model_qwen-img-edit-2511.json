  {
   "name": "sampler",
   "type": "select",
   "label": "Sampler",
   "group": "sampling",
   "order": 2,
   "width": 1,
   "options": [
    "er_sde",
    "euler",
    "euler_ancestral",
    "euler_cfg_pp",
    "dpmpp_2m",
    "dpmpp_2m_sde",
