    "lcm",
    "lms",
    "heun"
   ]
  },
  {
   "name": "scheduler",
   "type": "select",
   "label": "Scheduler",
   "group": "sampling",
   "order": 3,
   "width": 1,
   "options": [
    "normal",
    "karras",
    "exponential",
    "sgm_uniform",
    "simple",
    "ddim_uniform",
    "beta",
    "linear_quadratic",
    "kl_optimal"
   ]
  },
  {
   "name": "preset",
   "type": "select",
   "label": "Workflow Preset",
   "group": "edit_tuning",
   "order": 0,
   "width": 1,
   "tooltip": "Optional recipe preset — empty (default) = plain edit, the route's own catalog recipe (steps/cfg/loras from its defaults). vnccs_repose: the VNCCS re-pose recipe (external Lightning 4-step LoRA + VNCCS PoseStudio LoRA) for mesh-based re-pose flows — explicit only, never the default: its Lightning LoRA stacked on a Lightning-baked route (Apex int8, the fused lightning4) is double distillation (GPU-verified 2026-08-15). blue_mesh: blue-mesh overpaint mode — the builder loads the blue_mesh ControlNet stack.",
   "options": []
  },
  {
   "name": "use_stock_nodes",
   "type": "boolean",
   "label": "Use Stock Nodes",
   "group": "edit_tuning",
   "order": 1,
   "width": 1,
   "tooltip": "When true, build_img2img_edit emits the stock Qwen-Image-Edit node graph (no DiffSynth patches, no custom ControlNet wiring). Useful for reproducing upstream behavior exactly."
  },
  {
   "name": "double_reference",
   "type": "boolean",
   "label": "Double Reference",
   "group": "edit_tuning",
   "order": 2,
   "width": 1,
   "tooltip": "Encode the input image twice (VAE + vision encoder) for stronger identity preservation. Disable for faster runs where identity drift is acceptable."
  },
  {
   "name": "input_image",
   "type": "image",
   "label": "Image",
   "group": "input",
   "order": -1,
   "width": 1,
   "columns": 3,
   "required": true
  },
  {
   "name": "lanpaint_enabled",
   "type": "boolean",
   "label": "Force LanPaint",
   "group": "lanpaint",
   "order": 1,
   "default": false,
   "visible_when": "input_image != null"
  },
  {
   "name": "lanpaint_num_steps",
   "type": "number",
   "label": "Num Steps",
   "group": "lanpaint",
   "order": 2,
   "width": 1,
   "min": 1,
   "max": 100,
   "step": 1,
   "default": 20,
   "visible_when": "lanpaint_enabled == true"
  },
  {
   "name": "lanpaint_step_size",
   "type": "slider",
   "label": "Step Size",
   "group": "lanpaint",
   "order": 3,
   "width": 1,
   "min": 0.1,
   "max": 2,
   "step": 0.1,
   "default": 1.0,
   "visible_when": "lanpaint_enabled == true"
  },
  {
   "name": "lanpaint_lambda",
   "type": "slider",
   "label": "Lambda",
   "group": "lanpaint",
   "order": 4,
   "width": 1,
   "min": 0,
   "max": 2,
   "step": 0.05,
   "default": 0.5,
   "visible_when": "lanpaint_enabled == true"
  },
  {
   "name": "lanpaint_beta",
   "type": "slider",
   "label": "Beta",
   "group": "lanpaint",
   "order": 5,
   "width": 1,
   "min": 0,
   "max": 2,
   "step": 0.05,
   "default": 0.5,
   "visible_when": "lanpaint_enabled == true"
  },
  {
   "name": "lanpaint_friction",
   "type": "slider",
   "label": "Friction",
   "group": "lanpaint",
   "order": 6,
   "width": 1,
   "min": 0,
   "max": 2,
   "step": 0.05,
   "default": 0.5,
   "visible_when": "lanpaint_enabled == true"
  },
  {
   "name": "lanpaint_prompt_mode",
   "type": "select",
   "label": "Prompt Mode",
   "group": "lanpaint",
   "order": 7,
   "width": 1,
   "default": "negative",
   "visible_when": "lanpaint_enabled == true",
   "options": [
    "negative",
    "positive"
   ]
  },
  {
   "name": "outpaint_top",
   "type": "slider",
   "label": "Expand Top",
   "group": "lanpaint",
   "order": 8,
   "width": 1,
   "min": 0,
   "max": 512,
   "step": 8,
   "default": 0,
   "visible_when": "input_image != null"
  },
  {
   "name": "outpaint_right",
   "type": "slider",
   "label": "Expand Right",
   "group": "lanpaint",
   "order": 9,
   "width": 1,
   "min": 0,
   "max": 512,
   "step": 8,
   "default": 0,
   "visible_when": "input_image != null"
  },
  {
   "name": "outpaint_bottom",
   "type": "slider",
   "label": "Expand Bottom",
   "group": "lanpaint",
   "order": 10,
   "width": 1,
   "min": 0,
   "max": 512,
   "step": 8,
   "default": 0,
   "visible_when": "input_image != null"
  },
  {
   "name": "outpaint_left",
   "type": "slider",
   "label": "Expand Left",
   "group": "lanpaint",
   "order": 11,
   "width": 1,
   "min": 0,
   "max": 512,
   "step": 8,
   "default": 0,
   "visible_when": "input_image != null"
  },
  {
   "name": "outpaint_overlap",
   "type": "slider",
   "label": "Overlap",
   "group": "lanpaint",
   "order": 8,
   "width": 1,
   "min": 0,
   "max": 64,
   "step": 1,
   "default": 16,
   "visible_when": "input_image != null"
  },
  {
   "name": "input_mask",
   "type": "image",
   "label": "Region Mask",
   "group": "mask",
   "order": 0,
   "tooltip": "RGBA PNG whose alpha channel marks the region. Standalone: region semantics for this lane. Alongside lanpaint: the inpaint region — present with input_image, the builder switches to the lanpaint sampler."
  },
  {
   "name": "mask_mode",
   "type": "select",
   "label": "Region Mode",
   "group": "mask",
   "order": 1,
   "width": 1,
   "default": "auto",
   "tooltip": "How the mask is honored: auto (the lane's own region ControlNet if its weights are present, else crop+stitch), crop_stitch (crop to the mask + context, work the crop, composite back — pixels outside the mask never change), full_frame (legacy whole-image pass; unmasked regions may drift).",
   "options": [
    "auto",
    "crop_stitch",
    "full_frame"
   ]
  },
  {
   "name": "mask_context_pad",
   "type": "slider",
   "label": "Context Padding",
   "group": "mask",
   "order": 2,
   "width": 1,
   "min": 0,
   "max": 256,
   "step": 8,
   "default": 64,
   "tooltip": "Pixels of surrounding context kept in the crop (crop_stitch mode). More context = more coherence; 64 is the sweet spot."
  },
  {
   "name": "mask_grow",
   "type": "slider",
   "label": "Grow / Shrink",
   "group": "mask",
   "order": 3,
   "width": 1,
   "min": -32,
   "max": 32,
   "step": 1,
   "default": 8,
   "tooltip": "Expand (+) or shrink (−) the region by an exact pixel disk before the run. Applied host-side."
  },
  {
   "name": "mask_feather",
   "type": "slider",
   "label": "Feather",
   "group": "mask",
   "order": 4,
   "width": 1,
   "min": 0,
   "max": 32,
   "step": 1,
   "default": 8,
   "tooltip": "Gaussian falloff the composite blends through — kills the pasted-on rectangle edge."
  },
  {
   "name": "mask_threshold",
   "type": "slider",
   "label": "Re-threshold",
   "group": "mask",
   "order": 5,
   "width": 1,
   "min": 0,
   "max": 1,
   "step": 0.05,
   "default": 0,
   "tooltip": "Re-binarize the feathered mask at this level. 0 = keep the soft falloff."
  },
  {
   "name": "mask_invert",
   "type": "boolean",
   "label": "Invert",
   "group": "mask",
   "order": 6,
   "width": 1,
   "default": false,
   "tooltip": "Work OUTSIDE the painted region instead."
  }
 ],
