{
 "fields": [
  {
   "group": "input",
   "label": "Reference Images",
   "name": "reference_images",
   "order": 2,
   "tooltip": "Multi-image picker (up to 3). Used by workflows that pass resolved image lists; complements the individual Image 2 / Image 3 slots above.",
   "type": "image_list"
  },
  {
   "columns": 2,
   "group": "prompt",
   "label": "Prompt",
   "name": "prompt",
   "order": 0,
   "required": true,
   "type": "textarea",
   "width": 1
  },
  {
   "group": "prompt",
   "label": "Negative Prompt",
   "name": "negative_prompt",
   "order": 1,
   "type": "textarea",
   "visible_when": "negative_prompt != null",
   "width": 1
  },
  {
   "columns": 3,
   "group": "resolution",
   "label": "Width",
   "max": 2048,
   "min": 256,
   "name": "width",
   "order": 0,
   "step": 16,
   "type": "number",
   "width": 1
  },
  {
   "group": "resolution",
   "label": "Height",
   "max": 2048,
   "min": 256,
   "name": "height",
   "order": 1,
   "step": 16,
   "type": "number",
   "width": 1
  },
  {
   "default": -1,
   "group": "resolution",
   "label": "Seed",
   "name": "seed",
   "order": 4,
   "type": "seed",
   "width": 1
  },
  {
   "group": "sampling",
   "label": "Steps",
   "max": 50,
   "min": 1,
   "name": "steps",
   "order": 0,
   "step": 1,
   "type": "number",
   "width": 1
  },
  {
   "group": "sampling",
   "label": "Guidance Scale",
   "max": 10,
   "min": 0.1,
   "name": "cfg",
   "order": 1,
   "step": 0.1,
   "tooltip": "Qwen-Image-Edit uses low CFG (flow-matching).",
   "type": "slider",
   "width": 1
  },
  {
   "group": "sampling",
   "label": "Sampler",
   "name": "sampler",
   "options": [
    "er_sde",
    "euler",
    "euler_ancestral",
    "euler_cfg_pp",
    "dpmpp_2m",
    "dpmpp_2m_sde",
    "dpmpp_2m_sde_gpu",
    "dpmpp_3m_sde",
    "dpm_fast",
    "lcm",
    "lms",
    "heun"
   ],
   "order": 2,
   "type": "select",
   "width": 1
  },
  {
   "group": "sampling",
   "label": "Scheduler",
   "name": "scheduler",
   "options": [
    "normal",
    "karras",
    "exponential",
    "sgm_uniform",
    "simple",
    "ddim_uniform",
    "beta",
    "linear_quadratic",
    "kl_optimal"
   ],
   "order": 3,
   "type": "select",
   "width": 1
  },
  {
   "group": "loras",
   "label": "LoRAs",
   "name": "loras",
   "order": 0,
   "type": "loras"
  },
  {
   "group": "loras",
   "label": "ControlNet Strength Floor",
   "max": 1,
   "min": 0,
   "name": "controlnet_strength_floor",
   "order": 2,
   "step": 0.05,
   "tooltip": "Minimum strength any ControlNet in the stack may apply at. Entries below are clamped UP. 0.0 = no floor. Raise when stacking weak CNs that cost VRAM without visual benefit.",
   "type": "slider",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Force LanPaint",
   "name": "lanpaint_enabled",
   "order": 1,
   "type": "boolean",
   "visible_when": "input_image != null"
  },
  {
   "group": "lanpaint",
   "label": "Num Steps",
   "max": 100,
   "min": 1,
   "name": "lanpaint_num_steps",
   "order": 2,
   "step": 1,
   "type": "number",
   "visible_when": "lanpaint_enabled == true",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Step Size",
   "max": 2,
   "min": 0.1,
   "name": "lanpaint_step_size",
   "order": 3,
   "step": 0.1,
   "type": "slider",
   "visible_when": "lanpaint_enabled == true",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Lambda",
   "max": 2,
   "min": 0,
   "name": "lanpaint_lambda",
   "order": 4,
   "step": 0.05,
   "type": "slider",
   "visible_when": "lanpaint_enabled == true",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Beta",
   "max": 2,
   "min": 0,
   "name": "lanpaint_beta",
   "order": 5,
   "step": 0.05,
   "type": "slider",
   "visible_when": "lanpaint_enabled == true",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Friction",
   "max": 2,
   "min": 0,
   "name": "lanpaint_friction",
   "order": 6,
   "step": 0.05,
   "type": "slider",
   "visible_when": "lanpaint_enabled == true",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Prompt Mode",
   "name": "lanpaint_prompt_mode",
   "options": [
    "negative",
    "positive"
   ],
   "order": 7,
   "type": "select",
   "visible_when": "lanpaint_enabled == true",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Region Mode",
   "name": "edit_mask_mode",
   "options": [
    "auto",
    "crop_stitch",
    "full_frame"
   ],
   "order": 8,
   "tooltip": "How the region mask is honored: auto (DiffSynth ControlNet if its weights are present, else crop+stitch), crop_stitch (crop to the mask + context, edit the crop, composite back — pixels outside the mask never change), full_frame (legacy whole-image edit; unmasked regions may drift).",
   "type": "select",
   "visible_when": "input_image != null",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Context Padding",
   "max": 256,
   "min": 0,
   "name": "edit_context_pad",
   "order": 9,
   "step": 8,
   "tooltip": "Pixels of surrounding context kept in the crop (crop_stitch mode). More context = more coherent edit; 64 is the sweet spot.",
   "type": "slider",
   "visible_when": "input_image != null",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Grow / Shrink",
   "max": 32,
   "min": -32,
   "name": "mask_grow",
   "order": 10,
   "step": 1,
   "tooltip": "Expand (+) or shrink (−) the edit region by an exact pixel disk before the edit. Applied host-side — the same mask-prep chain the Inpaint card uses.",
   "type": "slider",
   "visible_when": "input_image != null",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Feather",
   "max": 32,
   "min": 0,
   "name": "mask_feather",
   "order": 11,
   "step": 1,
   "tooltip": "Gaussian falloff the composite blends through — kills the pasted-on rectangle edge.",
   "type": "slider",
   "visible_when": "input_image != null",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Re-threshold",
   "max": 1,
   "min": 0,
   "name": "mask_threshold",
   "order": 12,
   "step": 0.05,
   "tooltip": "Re-binarize the feathered mask at this level. 0 = keep the soft falloff.",
   "type": "slider",
   "visible_when": "input_image != null",
   "width": 1
  },
  {
   "group": "lanpaint",
   "label": "Invert",
   "name": "mask_invert",
   "order": 13,
   "tooltip": "Edit OUTSIDE the painted region instead.",
   "type": "boolean",
   "visible_when": "input_image != null",
   "width": 1
  }
 ],
