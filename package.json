{
  "name": "melite",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dependencies": {
    "@melite-plugin/dsh-card-deck": "0.2.2-alpha",
    "@melite-plugin/dsh-card-view": "0.2.2-alpha",
    "@melite-plugin/dsh-estate": "0.2.2-alpha",
    "@melite-plugin/dsh-gallery": "0.2.2-alpha",
    "@melite/card-base": "0.2.2-alpha",
    "@melite/harness-provisioner": "0.2.2-alpha",
    "@melite/harness-tools": "0.2.2-alpha",
    "@melite/image-input-prep": "0.2.2-alpha",
    "@melite/motion-motion": "0.2.2-alpha",
    "@melite/three-client": "0.2.2-alpha",
    "@melite/video-h3-timeline": "0.2.2-alpha"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.1-rc.2",
    "@melite/estate-drafts": "workspace:*",
    "@melite/estate-manage": "workspace:*",
    "@melite/estate-media": "workspace:*",
    "@melite/estate-queue": "workspace:*",
    "@melite/estate-runs": "workspace:*",
    "@melite/models-kimodo": "workspace:*",
    "@shikijs/langs": "4.4.3",
    "@types/node": "^22.20.0",
    "@vitest/coverage-istanbul": "4.1.11",
    "@vitest/coverage-v8": "^4.1.8",
    "anser": "2.3.5",
    "clsx": "2.1.1",
    "happy-dom": "^20.10.2",
    "istanbul-lib-report": "^3.0.1",
    "jsdom": "^29.1.1",
    "katex": "0.16.47",
    "knip": "^6.34.0",
    "lefthook": "^2.1.12",
    "leo-profanity": "1.9.0",
    "lightningcss": "^1.33.0",
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm": "3.1.0",
    "mdast-util-math": "3.0.0",
    "micromark-core-commonmark": "2.0.3",
    "micromark-extension-gfm": "3.0.0",
    "micromark-extension-math": "3.1.0",
    "micromark-factory-space": "2.0.1",
    "micromark-util-character": "2.1.1",
    "micromark-util-classify-character": "2.0.1",
    "micromark-util-sanitize-uri": "2.0.1",
    "micromark-util-symbol": "2.0.1",
    "naughty-words": "1.2.0",
    "publint": "^0.3.25",
    "shiki": "4.4.3",
    "simple-icons": "16.31.0",
    "vitest": "^4.1.8",
    "yaml": "2.9.1",
    "zod": "4.4.3"
  },
  "scripts": {
    "hooks:seat": "node tools/install-lefthook.mjs",
    "seat:render": "node tools/render-seat-patch.mjs",
    "seat:check": "node tools/render-seat-patch.mjs --check",
    "build": "node tools/build-plane.mjs build",
    "knip": "node tools/knip-budget.mjs",
    "contract": "node scripts/contracts.mjs",
    "lint": "node tools/arch-lint.ts",
    "test:docs": "node tools/check-package-readmes.mjs",
    "docs:dev": "pnpm --filter @melite/docs run dev",
    "docs:build": "pnpm --filter @melite/docs run build",
    "provision": "node --experimental-strip-types --no-warnings packages/engines/comfyui-cordis/scripts/provision.ts",
    "release:mint": "node tools/release-artifacts.mjs mint",
    "release:rehearse": "node tools/release-rehearsal.mjs",
    "release:verify": "node tools/release-artifacts.mjs verify",
    "release:bump": "node scripts/bump-release-version.mjs",
    "lane:promote-prod": "bash scripts/promote-prod.sh",
    "probe:fresh-clone": "node tools/fresh-clone-probe.mjs",
    "proof:cold-start": "node tools/cold-start-proof.mjs",
    "rehearse:first-image": "node tools/first-image-rehearsal.mjs",
    "test": "node scripts/run-walker-safe.mjs vitest run",
    "test:bench": "vitest run --config vitest.bench.config.ts",
    "test:typecheck": "node node_modules/vitest/dist/cli.js run --config vitest.config.ts --project typecheck-lane",
    "test:coverage": "node scripts/run-walker-safe.mjs --coverage-shared vitest run --coverage && node scripts/coverage-rows-tripwire.mjs",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:coldstart": "vitest run --config vitest.coldstart.config.ts",
    "test:e2e:studio": "bash scripts/e2e-studio-lane.sh",
    "test:e2e:gpu": "bash scripts/e2e-gpu-lane.sh",
    "test:expected": "vitest run --config vitest.expected.config.ts",
    "test:expected:refresh": "DSH_SNAPSHOT=refresh vitest run --config vitest.expected.config.ts",
    "test:lane": "vitest run --config vitest.e2e.config.ts tests/lane/3088-lane.e2e.ts",
    "test:lane:analyse": "node --experimental-strip-types tests/lane/run.ts analyse",
    "test:lane:commission": "node --experimental-strip-types tests/lane/run.ts commission",
    "test:py": "python3 -m pytest tests/ -q",
    "test:snapshot": "vitest run --config vitest.snapshot.config.ts",
    "test:snapshot:record": "DSH_SNAPSHOT=record vitest run --config vitest.snapshot.config.ts --update",
    "test:snapshot:refresh": "DSH_SNAPSHOT=refresh vitest run --config vitest.snapshot.config.ts",
    "test:web": "vitest run --config vitest.web.config.ts",
    "test:combinations": "pnpm --filter @melite-plugin/dsh-card-deck exec playwright test e2e/combinations-sweep.spec.ts",
    "test:web:browser": "bash scripts/e2e-studio-lane.sh && pnpm --filter @melite-plugin/dsh-card-deck exec playwright test",
    "test:web:mesh": "pnpm --filter @melite-plugin/dsh-gallery run build:mesh-door && pnpm --filter @melite-plugin/dsh-gallery exec playwright test",
    "test:web:refresh": "DSH_SNAPSHOT=refresh vitest run --config vitest.web.config.ts"
  },
  "license": "AGPL-3.0-or-later",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "pnpm": {
    "overrides": {
      "@deepseek-ai/cosmokit": "1.8.5"
    },
    "patchedDependencies": {
      "@stable-canvas/comfyui-client@1.5.9": "patches/@stable-canvas__comfyui-client@1.5.9.patch"
    }
  }
}
