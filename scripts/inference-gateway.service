# inference-gateway.service — reference copy of the CANONICAL gateway unit
#
# STATUS 2026-09-02 (python flip): the C server (build/inference_cli) is
# RETIRED — the gateway is the python orchestrator (py/gateway.py,
# stdlib-only asyncio; engines + card compose live in the OWNING
# plugins, py/plugins.py mounts them). This unit supervises :33081 with
# Restart=always.
#
# PORT LAW: every skill and the dsh melite-card-deck proxy point at
# http://localhost:33081 — do not move the port.
#
# If re-installing from this copy:
#   cp scripts/inference-gateway.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user restart inference-gateway
#
# logs: journalctl --user -u inference-gateway -f

[Unit]
Description=inference.cpp gateway (canonical :33081 — python orchestrator)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/programs/active/inference.cpp
ExecStart=/usr/bin/python3 %h/Documents/programs/active/inference.cpp/py/gateway.py 33081
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
