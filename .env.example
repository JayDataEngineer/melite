# Melite deployment environment — copy to .env (gitignored) and fill
# for YOUR machine. Every value is optional; scripts fall back to
# neutral localhost/$HOME defaults so a fresh clone runs without one.
# Never commit real values (hosts, units, weights roots) — the tree
# stays deployment-neutral.

# ── the lane (scripts/lane-*.sh, ship-lane.sh) ──
# Where the dsh-dev profile tree lives (lane-rebuild/lane-sync target).
#LANE_DSH_HOME=$HOME/.dsh-dev
# The systemd units ship-lane restarts. Override BOTH unit+origin
# together — the sanctioned-pair check refuses one alone.
#MELITE_SHIP_UNIT=dsh-melite-test.service
#MELITE_LANE_ORIGIN=http://127.0.0.1:3088
# Host shown in lane-rebuild's URL hint when not localhost.
#MELITE_PUBLIC_HOST=127.0.0.1

# ── promote-prod.sh ──
#MELITE_PROD_URL=http://127.0.0.1:3080
#MELITE_DEV_URL=http://127.0.0.1:3088

# ── e2e GPU lanes ──
# Where the ComfyUI weights tree lives (e2e-h3-gpu-lane.sh).
#MELITE_H3_WEIGHTS_ROOT=$HOME/tools/comfyui/models

# ── engine probes (tools/reproject-combos.mjs, regen-node-vocab.mjs) ──
#MELITE_OBJECT_INFO=http://127.0.0.1:8188/object_info
