# inference.cpp profile patch layer — rendered by dsh/install-profile.sh
# ({{REPO_ROOT}} → absolute repo path, {{GATEWAY_URL}} → gateway endpoint).
#
# HOST rows (absolute .mjs/.js artifact paths) mount the plugins that
# own the tool registry and web routes; CLIENT rows (package names,
# resolved from this profile's node_modules) mount the browser-side
# bundles. This file is the single mount surface for the whole media
# stack — no separate --patch overlay needed at boot.

- insert:
    # The tool surface: model_catalog, build_pipeline, lane_bundle,
    # provision_model, enhance_prompt, skill_index, skill_read,
    # ledger_tail + one tool per card manifest (/v1/card-tools).
    - id: infer-tools
      name: '{{REPO_ROOT}}/dsh/melite-tools/lib/index.mjs'
      config:
        gatewayUrl: '{{GATEWAY_URL}}'

    # Card view: host row serves the editor bundle + hydrates drafts;
    # client row renders the editable action cards in the conversation.
    - id: infer-card-view-host
      name: '{{REPO_ROOT}}/dsh/melite-card-view/lib/index.js'
      config:
        gatewayUrl: '{{GATEWAY_URL}}'
    - id: infer-card-view-client
      name: '@melite-plugin/dsh-card-view'
      config:
        clientRowOnly: true

    # Card deck sidebar: browse lanes, drafts, and past cards.
    - id: infer-card-deck
      name: '@melite-plugin/dsh-card-deck'
      config:
        gatewayUrl: '{{GATEWAY_URL}}'

    # Gallery: the runs gallery (served from this repo, no ray dep).
    - id: infer-gallery-host
      name: '{{REPO_ROOT}}/dsh/infer-gallery/lib/index.js'
      config:
        gatewayUrl: '{{GATEWAY_URL}}'

    # Media bar: inline media previews against the gateway.
    - id: infer-media
      name: '@infer-media/dsh-media'
      config:
        gateways:
          - '{{GATEWAY_URL}}'

    # Greeting proof-of-life row.
    - id: infer-hello
      name: '{{REPO_ROOT}}/dsh/melite-hello/lib/index.mjs'
      config:
        greeting: 'Inference lane online'
