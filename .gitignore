# === Web build artifacts ===
# Prebundled three.js (~10 MB) — `npm install three` regenerates it
# from node_modules; vendor/draco and vendor/examples/jsm are
# committed source and stay.
plugins/web/editor/public/vendor/build/
# Skin preview snapshots (build outputs from the standalone-classic
# skin renderer). Currently caught by *.png, but a non-PNG added to
# preview/ would leak — dir rule makes the intent explicit.
plugins/web/dsh/skins/**/preview/

# === session scratch (kept on disk, out of git) ===
# Root-anchored: the bare `drafts/` rule accidentally ignored the
# packages/estate/drafts PACKAGE (its src went unversioned through
# the REBUILD commits — caught 2026-09-10).
/agent-sessions/
/drafts/

# === Dead C++ era (post python-orchestrator migration) ===
third_party/
# === Live C++ engine build dirs ===
# kimodo / autoremesher / anycreature build out-of-source into
# data/runtime/<engine>/build/ (cmake out-of-source layout). The
# legacy top-level build/ is gone (C gateway retired 2026-09-03),
# but cpp engines WILL land here — ignore ahead of time.
data/runtime/*/build/
data/runtime/*/build-*/

# === Python plugin venvs (per-plugin uv envs, the management plane
# stays base) ===
# The root .venv is the gateway base env (estate). Plugin-local
# .venv dirs (e.g. plugins/harness/dsh/infer-flow-tavern/.venv) are
# material on `uv sync` from the plugin dir; the install surface is
# `uv tool install` or `uvx`, not git. Both patterns are matched
# by a single **/.venv entry — every level, every plugin.
/.venv
plugins/**/.venv
**/.venv
# === Python plugin session scratch (uvicorn + starlette) ===
# uvicorn + starlette dump a `.sesskey` on boot when the TestClient
# spins up; it's a per-run session id, never source.
/.sesskey
plugins/**/.sesskey
**/.sesskey

# data/ — the data root (never commit state; README is the law doc)
# ONE rule: ignore everything under data/, then re-include directory
# traversal (so .gitkeep discovery works) and the law doc. The old
# per-subdir list + a trailing !data/**/ negation broke itself —
# dir-only ignores lose to the later dir negation, git descended, and
# NO pattern matched any file: everything under data/ was committable,
# llm_keystore.json/.key included. (-pattern lines were not gitignore
# syntax at all — dead text.)
data/**
!data/**/
!data/README.md
!data/**/.gitkeep
# provision-materialized nested checkouts (deployment state, never
# source — the pins live in tools/provision.py; the !data/**/
# traversal re-inclusion would otherwise surface them as unborn
# submodules). The worker scripts' canonical homes are flows/
# (provision copies them in at sync time).
data/runtime/anny-commercial/SOMA-X/
data/runtime/anny-commercial/sam-3d-body/
# the provisioned ComfyUI checkout is an EMBEDDED REPO (has .git) —
# without an explicit row, `git add data/` would re-record it as a
# gitlink (exactly what commit 5dc013e4 did by accident).
data/runtime/comfyui/

# Platform tier vendored plugins: lib/ is BUILT per-host by
# plugins/gateway/scripts/link-vendored-platform.sh (harness layout), never committed
vendor/cordis_plugins/*/lib/
test-results/
packages/harness/estate-queue/dist/

# the 3D door browser wall harness bundle (built by `pnpm run test:web:mesh`)
packages/web/infer-gallery/e2e/mesh-door/dist/

# dsh lane runtime lock (the 3088 lock-wait guard's file)
gateway.lock
